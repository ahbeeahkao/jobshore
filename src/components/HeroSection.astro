---
import { COMPANY_INFO } from '../data/siteData';
---

<section class="relative overflow-hidden border-b border-slate-800/80 bg-radial-glow bg-grid-pattern pt-12 pb-20 sm:pt-16 lg:pt-20 lg:pb-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <!-- Left Column: Value Proposition & AEO Direct Answer Capsule -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1.5 text-xs font-semibold text-sky-300">
          <span class="flex h-2 w-2 rounded-full bg-sky-400"></span>
          <span id="i18n-hero-badge">Enterprise AI • Automation • Frappe ERPNext • POS Systems • Web &amp; Mobile</span>
        </div>

        <h1
          id="hero-headline"
          class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-[3.2rem] lg:leading-[1.12]"
        >
          Ship Verified <span class="bg-gradient-to-r from-sky-400 via-cyan-300 to-emerald-400 bg-clip-text text-transparent">AI &amp; OCR</span>,
          Autonomous Workflows, <span class="bg-gradient-to-r from-indigo-400 to-sky-400 bg-clip-text text-transparent">Frappe ERPNext</span> &amp; <span class="bg-gradient-to-r from-amber-300 to-orange-400 bg-clip-text text-transparent">POS Systems</span>.
        </h1>

        <!-- AEO Direct Answer Capsule (Targeted by SpeakableSpecification & LLM Crawlers) -->
        <aside
          aria-label="Executive Summary for Search and Answer Engines"
          class="aeo-summary rounded-2xl border border-slate-800 bg-slate-900/75 p-4 sm:p-5 text-sm leading-relaxed text-slate-300 shadow-inner"
        >
          <div class="mb-1.5 flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-sky-400">
            <span>Direct Answer Overview • Jobshore Capabilities (EN / BM / 中文)</span>
            <span class="rounded bg-slate-800 px-2 py-0.5 font-mono text-[10px] text-emerald-400">AEO Verified</span>
          </div>
          <p id="i18n-hero-summary">
            <strong class="text-white">Jobshore</strong> is an enterprise engineering consultancy serving
            <strong class="text-white">Malaysia, Southeast Asia, and Global B2B</strong> clients across five core pillars:
            (1) <strong class="text-sky-300">AI Coding, Deterministic Verification, Self-Healing Automated Testing &amp; 99.4% Enterprise OCR</strong>,
            (2) <strong class="text-emerald-300">End-to-End Business Process Automation</strong>,
            (3) <strong class="text-indigo-300">Frappe &amp; ERPNext Consultation &amp; Implementation</strong>,
            (4) <strong class="text-amber-300">Cloud &amp; Offline-First POS Software &amp; Retail/F&amp;B Systems</strong> (with real-time Malaysia LHDN MyInvois B2B, QR Self-Claim &amp; Consolidated e-Invoicing), and
            (5) <strong class="text-violet-300">SEO/AEO-First Web &amp; Cross-Platform Mobile App Development</strong>.
          </p>
        </aside>

        <!-- 5 Core Pillar Quick-Jump Pills -->
        <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-3 pt-1">
          <a
            href="#ai-services"
            class="group flex items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/60 px-3 py-2.5 text-left transition hover:border-sky-500/50 hover:bg-slate-900"
          >
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-sky-500/15 text-sky-400 font-bold text-xs">
              01
            </span>
            <div>
              <div
                class="text-xs font-bold text-white group-hover:text-sky-300"
                data-i18n-en="AI Coding, Verify, QA & OCR"
                data-i18n-bm="Pengekodan AI, Pengesahan & OCR"
                data-i18n-zh="AI 编程、验证、测试与 OCR"
              >
                AI Coding, Verify, QA &amp; OCR
              </div>
              <div class="text-[11px] text-slate-400">LLM • 99.4% OCR • Playwright</div>
            </div>
          </a>

          <a
            href="#business-automation"
            class="group flex items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/60 px-3 py-2.5 text-left transition hover:border-emerald-500/50 hover:bg-slate-900"
          >
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-emerald-500/15 text-emerald-400 font-bold text-xs">
              02
            </span>
            <div>
              <div
                class="text-xs font-bold text-white group-hover:text-emerald-300"
                data-i18n-en="Business Automation"
                data-i18n-bm="Automasi Bisnes (BPA)"
                data-i18n-zh="企业业务流程自动化"
              >
                Business Automation
              </div>
              <div class="text-[11px] text-slate-400">3-Way Match • WhatsApp API</div>
            </div>
          </a>

          <a
            href="#erpnext-services"
            class="group flex items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/60 px-3 py-2.5 text-left transition hover:border-indigo-500/50 hover:bg-slate-900"
          >
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-indigo-500/15 text-indigo-400 font-bold text-xs">
              03
            </span>
            <div>
              <div
                class="text-xs font-bold text-white group-hover:text-indigo-300"
                data-i18n-en="Frappe & ERPNext"
                data-i18n-bm="Konsultasi Frappe ERPNext"
                data-i18n-zh="Frappe ERPNext 咨询实施"
              >
                Frappe &amp; ERPNext
              </div>
              <div class="text-[11px] text-slate-400">Turn-Key ERP • LHDN MyInvois</div>
            </div>
          </a>

          <a
            href="#pos-services"
            class="group flex items-center gap-3 rounded-xl border border-amber-500/30 bg-slate-900/70 px-3 py-2.5 text-left transition hover:border-amber-400 hover:bg-slate-900"
          >
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-500/15 text-amber-400 font-bold text-xs">
              04
            </span>
            <div>
              <div
                class="text-xs font-bold text-white group-hover:text-amber-300"
                data-i18n-en="POS Software & Systems"
                data-i18n-bm="Perisian & Sistem POS"
                data-i18n-zh="智能零售与餐饮 POS 系统"
              >
                POS Software &amp; Systems
              </div>
              <div class="text-[11px] text-slate-400">Retail &amp; F&amp;B • Offline + LHDN QR</div>
            </div>
          </a>

          <a
            href="#web-mobile-services"
            class="group flex items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/60 px-3 py-2.5 text-left transition hover:border-violet-500/50 hover:bg-slate-900 sm:col-span-2 lg:col-span-2"
          >
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-violet-500/15 text-violet-400 font-bold text-xs">
              05
            </span>
            <div>
              <div
                class="text-xs font-bold text-white group-hover:text-violet-300"
                data-i18n-en="Web & Mobile App Development"
                data-i18n-bm="Pembangunan Laman Web & Aplikasi Mudah Alih"
                data-i18n-zh="全栈网站与 iOS/Android 移动应用开发"
              >
                Web &amp; Mobile App Development
              </div>
              <div class="text-[11px] text-slate-400">100/100 SEO &amp; AEO Web Platforms • Cross-Platform Flutter &amp; React Native Apps</div>
            </div>
          </a>
        </div>

        <!-- Primary CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="#contact"
            class="inline-flex items-center gap-2.5 rounded-xl bg-gradient-to-r from-sky-500 to-emerald-500 px-6 py-3.5 text-sm font-bold text-slate-950 shadow-xl shadow-sky-500/20 transition hover:brightness-110"
          >
            <span id="i18n-cta-primary">Request Architecture &amp; Quote</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>

          <a
            href="#interactive-lab"
            class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-900/90 px-5 py-3.5 text-sm font-semibold text-white transition hover:border-sky-500/50 hover:bg-slate-800"
          >
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            <span id="i18n-cta-secondary">Try Live AI OCR, POS &amp; Verification Lab</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Unified Architecture Stack Showcase -->
      <div class="lg:col-span-5">
        <div class="relative rounded-2xl border border-slate-800 bg-slate-900/90 p-5 shadow-2xl shadow-sky-950/40">
          <!-- Window Top Bar -->
          <div class="flex items-center justify-between border-b border-slate-800 pb-3.5">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-rose-500/80"></span>
              <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
              <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
              <span class="ml-2 font-mono text-xs text-slate-400">jobshore-enterprise-stack.ts</span>
            </div>
            <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-emerald-400">
              5-PILLAR UNIFIED STACK
            </span>
          </div>

          <!-- Pipeline Layers -->
          <div class="mt-4 space-y-2.5">
            <!-- Layer 1: AI & OCR -->
            <div class="rounded-xl border border-sky-500/30 bg-slate-950/80 p-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-sky-400">
                  1. AI Coding, Verification, QA &amp; OCR
                </span>
                <span class="font-mono text-[11px] text-emerald-400">99.4% Accuracy</span>
              </div>
              <p class="mt-1 text-xs text-slate-300">
                Multi-language Invoice/DO OCR extraction + AST Code Verification + Self-healing Playwright E2E checks.
              </p>
            </div>

            <!-- Layer 2: Business Process Automation -->
            <div class="rounded-xl border border-emerald-500/30 bg-slate-950/80 p-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">
                  2. Autonomous Workflow &amp; BPA Engine
                </span>
                <span class="font-mono text-[11px] text-emerald-400">Zero Touch</span>
              </div>
              <p class="mt-1 text-xs text-slate-300">
                Automated 3-way PO-GRN-Invoice reconciliation, WhatsApp Cloud API approvals &amp; bank feed matching.
              </p>
            </div>

            <!-- Layer 3: POS Software & Retail/F&B Systems -->
            <div class="rounded-xl border border-amber-500/30 bg-slate-950/80 p-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-400">
                  3. Cloud &amp; Offline POS Software &amp; Hardware
                </span>
                <span class="font-mono text-[11px] text-amber-300">Offline + LHDN QR</span>
              </div>
              <p class="mt-1 text-xs text-slate-300">
                Retail &amp; F&amp;B checkout, KDS, thermal receipt QR e-Invoice self-claim &amp; monthly LHDN Consolidated sync.
              </p>
            </div>

            <!-- Layer 4: Frappe ERPNext + Web/Mobile -->
            <div class="rounded-xl border border-indigo-500/30 bg-slate-950/80 p-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-indigo-400">
                  4. Frappe ERPNext + Web &amp; Mobile Apps
                </span>
                <span class="font-mono text-[11px] text-sky-400">LHDN MyInvois UUID ✓</span>
              </div>
              <p class="mt-1 text-xs text-slate-300">
                Real-time multi-outlet inventory &amp; accounting ledger synced with Astro web portals &amp; Flutter mobile apps.
              </p>
            </div>
          </div>

          <!-- Bottom Telemetry Strip -->
          <div class="mt-4 flex items-center justify-between rounded-lg bg-slate-950 px-3.5 py-2.5 text-[11px] text-slate-400">
            <span>SEO/AEO Ready: <strong class="text-white">EN / BM / 中文 • llms.txt</strong></span>
            <button
              type="button"
              data-open-seo-modal
              class="font-semibold text-sky-400 hover:underline cursor-pointer"
            >
              Inspect Schema →
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Authority KPI Strip -->
    <dl class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {COMPANY_INFO.stats.map((stat) => (
        <div class="rounded-2xl border border-slate-800/90 bg-slate-900/50 p-5 backdrop-blur">
          <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">{stat.label}</dt>
          <dd class="mt-1 text-3xl font-extrabold tracking-tight text-white">{stat.value}</dd>
          <p class="mt-1 text-xs text-slate-400">{stat.detail}</p>
        </div>
      ))}
    </dl>
  </div>
</section>
