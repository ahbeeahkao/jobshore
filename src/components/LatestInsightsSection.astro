---
import { INSIGHT_ARTICLES, REGULATORY_AND_AI_NEWS_RADAR } from '../data/insightsData';
import { withBase } from '../utils/paths';
---

<section
  id="insights"
  class="scroll-mt-20 border-t border-slate-800/80 py-20 sm:py-24"
  aria-labelledby="insights-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-sky-300">
          Executive Briefings, 2026 Regulatory Radar &amp; LHDN Compliance Guides
        </span>
        <h2 id="insights-heading" class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Practical Playbooks for Cost Reduction, LHDN e-Invoicing &amp; Zero-Defect AI
        </h2>
        <p class="mt-2 text-sm sm:text-base text-slate-400">
          Actionable strategies and live regulatory updates for Malaysian, Southeast Asian, and global leaders on eliminating manual bottlenecks, claiming tax incentives, and scaling retail/ERP operations.
        </p>
      </div>
    </div>

    <!-- 2026 MALAYSIA REGULATORY, TAX INCENTIVE & ENTERPRISE AI RADAR (LIVE NEWS STRIP) -->
    <div class="mt-10 rounded-3xl border border-emerald-500/30 bg-gradient-to-br from-slate-900/95 via-slate-950 to-emerald-950/20 p-6 sm:p-8 shadow-2xl">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800/90 pb-4">
        <div class="flex items-center gap-2.5">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
          </span>
          <h3 class="text-sm sm:text-base font-extrabold uppercase tracking-wider text-white">
            📡 Malaysia 2026 Regulatory, Tax Deduction &amp; Enterprise AI Radar
          </h3>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-emerald-500/35 bg-emerald-500/10 px-3 py-0.5 font-mono text-[11px] font-bold text-emerald-300">
            Updated Oct 2026 • LHDN &amp; PDPA Verified
          </span>
          <a
            href={withBase('/rss.xml')}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 rounded-full border border-sky-500/35 bg-sky-500/10 px-3 py-0.5 font-mono text-[11px] font-bold text-sky-300 transition hover:bg-sky-500/20"
          >
            <span>📡 RSS Feed (/rss.xml)</span>
          </a>
        </div>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {REGULATORY_AND_AI_NEWS_RADAR.map((news) => (
          <div class="flex flex-col justify-between rounded-2xl border border-slate-800/90 bg-slate-950/85 p-4 transition hover:border-emerald-500/40">
            <div>
              <div class="flex items-center justify-between gap-2 text-[11px]">
                <span class="rounded bg-emerald-500/15 px-2 py-0.5 font-bold text-emerald-300">
                  {news.badge}
                </span>
                <span class="font-mono text-slate-400">{news.date}</span>
              </div>
              <h4 class="mt-3 text-xs sm:text-sm font-bold text-white leading-snug">
                {news.title}
              </h4>
              <p class="mt-2 text-xs text-slate-400 leading-relaxed">
                {news.summary}
              </p>
            </div>
            <div class="mt-4 pt-2.5 border-t border-slate-800/80">
              <a
                href={withBase(news.actionHref)}
                class="inline-flex items-center gap-1 text-xs font-bold text-sky-400 hover:text-sky-300"
              >
                <span>{news.actionLabel}</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {INSIGHT_ARTICLES.map((post) => (
        <article class="flex flex-col justify-between rounded-2xl border border-slate-800/90 bg-slate-900/50 p-6 transition hover:border-sky-500/40">
          <div>
            <div class="flex items-center justify-between gap-2 text-xs">
              <span class="rounded-full border border-sky-500/30 bg-sky-500/10 px-2.5 py-0.5 font-semibold text-sky-300">
                {post.category}
              </span>
              <time datetime={post.publishedDate} class="font-mono text-[11px] text-slate-400">
                {post.publishedDate} • {post.readTime}
              </time>
            </div>

            <h3 class="mt-4 text-lg font-bold text-white leading-snug">
              <a href={withBase(`/insights/${post.slug}`)} class="hover:text-sky-300 transition">
                {post.title}
              </a>
            </h3>

            <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-slate-400">
              {post.excerpt}
            </p>

            <!-- Executive Outcome Preview -->
            <div class="mt-4 rounded-xl border border-slate-800 bg-slate-950/70 p-3 text-xs text-slate-300">
              <span class="font-bold text-emerald-400 text-[10px] uppercase tracking-wider block mb-1">
                Bottom-Line Impact:
              </span>
              {post.keyTakeaways[0]}
            </div>
          </div>

          <div class="mt-6 border-t border-slate-800/80 pt-4 flex items-center justify-between">
            <a
              href={withBase(`/insights/${post.slug}`)}
              class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-400 hover:text-sky-300"
            >
              <span>Read Executive Playbook</span>
              <span>→</span>
            </a>
            <span class="font-mono text-[10px] text-slate-400">{post.readTime}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
