---
import { ERP_COMPARISON_ROWS } from '../data/siteData';

const erpModules = [
  {
    name: 'Financial Accounting & LHDN MyInvois',
    desc: 'Multi-company, multi-currency ledger, real-time LHDN e-Invoicing (B2B, Consolidated, Self-Billed), SST & bank reconciliation.',
  },
  {
    name: 'Manufacturing, BOM & Shop Floor MES',
    desc: 'Multi-level Bill of Materials, capacity planning, subcontracting, work order routing, scrap tracking, and real-time job cards.',
  },
  {
    name: 'Multi-Warehouse Inventory & Traceability',
    desc: 'Batch & serial number tracking, barcode/RFID mobile picking, automated reorder levels, landed cost vouchers, and QC gates.',
  },
  {
    name: 'Buying, Selling, CRM & B2B Portals',
    desc: 'Quotation-to-cash, blanket orders, supplier scorecards, omnichannel POS, and automated 3-way PO-GRN-Invoice matching.',
  },
  {
    name: 'Frappe HRMS & Malaysia Statutory Payroll',
    desc: 'Leave & shift management, expense claims with AI OCR receipt capture, and Malaysian EPF/KWSP, SOCSO, EIS & PCB/MTD payroll.',
  },
  {
    name: 'Projects, Helpdesk & Custom Frappe Apps',
    desc: 'Milestone billing, timesheet costing, SLA customer support tickets, and 100% upgrade-safe custom Frappe Doctypes & BI dashboards.',
  },
];
---

<section
  id="erp-comparison"
  class="scroll-mt-20 py-20 sm:py-24"
  aria-labelledby="erp-comparison-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-indigo-300">
        Frappe &amp; ERPNext Implementation Excellence
      </span>
      <h2 id="erp-comparison-heading" class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Why High-Growth Enterprises Choose Jobshore’s Frappe ERPNext Over Legacy ERPs
      </h2>
      <p class="mt-3 text-base text-slate-400">
        Eliminate per-user licensing penalties while gaining full source-code ownership, native AI OCR automation, and
        turn-key <strong class="text-white">Malaysia LHDN MyInvois</strong> compliance.
      </p>
    </div>

    <!-- 6 Core ERPNext Modules Grid -->
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {erpModules.map((mod) => (
        <div class="rounded-2xl border border-slate-800/90 bg-slate-900/50 p-5 transition hover:border-indigo-500/40">
          <div class="flex items-center gap-2.5">
            <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-500/15 text-indigo-400 text-xs font-bold">
              ✓
            </span>
            <h3 class="text-sm font-bold text-white">{mod.name}</h3>
          </div>
          <p class="mt-2.5 text-xs leading-relaxed text-slate-400">{mod.desc}</p>
        </div>
      ))}
    </div>

    <!-- Semantic HTML Comparison Matrix (Optimized for AEO & Featured Snippets) -->
    <div class="mt-12 overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/70 shadow-2xl">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <caption class="border-b border-slate-800 bg-slate-950/80 px-6 py-4 text-left text-xs font-semibold uppercase tracking-wider text-slate-400">
            Enterprise ERP Comparison Matrix: Jobshore Frappe ERPNext vs. Legacy Tier-1 ERP vs. Basic Accounting Software
          </caption>
          <thead>
            <tr class="border-b border-slate-800 bg-slate-950/50 text-xs uppercase tracking-wider text-slate-300">
              <th scope="col" class="py-4 px-6 font-bold">Evaluation Criterion</th>
              <th scope="col" class="py-4 px-6 font-bold text-sky-300 bg-sky-500/10">
                Jobshore Frappe ERPNext + AI
              </th>
              <th scope="col" class="py-4 px-6 font-bold text-slate-400">
                Legacy Tier-1 ERP (SAP B1 / NetSuite)
              </th>
              <th scope="col" class="py-4 px-6 font-bold text-slate-400">
                Basic Accounting (AutoCount / SQL / Xero)
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80 text-sm">
            {ERP_COMPARISON_ROWS.map((row) => (
              <tr class="transition hover:bg-slate-800/30">
                <th scope="row" class="py-4 px-6 font-semibold text-white">
                  {row.criterion}
                </th>
                <td class="py-4 px-6 font-semibold text-emerald-300 bg-sky-500/5">
                  {row.jobshoreErpnext}
                </td>
                <td class="py-4 px-6 text-slate-400">
                  {row.legacyTier1}
                </td>
                <td class="py-4 px-6 text-slate-400">
                  {row.basicAccounting}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
