test.describe('ERPNext Purchase Invoice OCR & LHDN MyInvois E2E Flow', () => {
  test('extracts multi-language invoice via OCR, verifies 3-way match, and obtains LHDN UUID', async ({ page, api, aiLocator }) => {
    // 1. Upload scanned supplier tax invoice to Jobshore IDP portal
    await page.goto('/automation/invoice-intake');
    await page.setInputFiles('[data-testid="ocr-dropzone"]', 'fixtures/sinar-tax-invoice-myr.pdf');

    // 2. Assert OCR confidence & deterministic math check
    const ocrStatus = await aiLocator('OCR Verification Status Badge').element();
    await expect(ocrStatus).toContainText('99.7% Verified');

    // 3. Trigger automated 3-way match against ERPNext PO & GRN
    const submitBtn = await aiLocator('Approve & Sync to ERPNext Button').element();
    await submitBtn.click();

    // 4. Verify backend ERPNext Ledger & LHDN MyInvois API contract
    const response = await api.waitForWebhook('/api/erpnext/purchase-invoice/synced');
    expect(response.status).toBe(200);
    expect(response.body).toMatchObject({
      doctype: 'Purchase Invoice',
      threeWayMatchStatus: 'MATCHED_ZERO_VARIANCE',
      lhdnMyInvoisStatus: 'VALID',
      grandTotalMYR: 18684.00,
    });
    expect(response.body.lhdnUuid).toMatch(/^[A-Z0-9]{26}$/);
  });
});`}</pre>
