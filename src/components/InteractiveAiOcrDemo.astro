      btn.classList.add('border-sky-500', 'bg-sky-500/15', 'text-white', 'font-bold');

      Object.entries(panels).forEach(([key, panel]) => {
        if (!panel) return;
        if (key === target) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });
</script>
