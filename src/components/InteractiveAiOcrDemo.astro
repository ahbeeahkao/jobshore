import { z } from 'zod';

const InvoiceInputSchema = z.object({
  invoiceId: z.string().regex(/^INV-\\d{4}-\\d{5}$/),
  subtotalSen: z.number().int().nonnegative(), // Exact integer sen/cents
  idempotencyKey: z.string().uuid(),
});

export async function postVerifiedInvoice(db: DatabasePool, rawInput: unknown) {
  const input = InvoiceInputSchema.parse(rawInput);

  // Deterministic banker's rounding in integer minor units (sen)
  const subtotal = new Decimal(input.subtotalSen);
  const sstTaxSen = subtotal.mul('0.08').toDecimalPlaces(0, Decimal.ROUND_HALF_EVEN);
  const grandTotalSen = subtotal.add(sstTaxSen);

  // Invariant assertion before DB transaction
  if (!grandTotalSen.sub(sstTaxSen).equals(subtotal)) {
    throw new Error('Financial invariant violation: ledger imbalance');
  }

  // Parameterized, idempotent transaction
  return await db.transaction(async (tx) => {
    return await tx.query(
      \`INSERT INTO invoices (invoice_id, subtotal_sen, tax_sen, total_sen, idempotency_key)
       VALUES ($1, $2, $3, $4, $5)
       ON CONFLICT (idempotency_key) DO NOTHING
       RETURNING invoice_id, total_sen\`,
      [input.invoiceId, subtotal.toNumber(), sstTaxSen.toNumber(), grandTotalSen.toNumber(), input.idempotencyKey]
    );
  });
}`}</pre>
