---
import { COMPANY_INFO } from '../data/siteData';
---

<section
  id="contact"
  class="scroll-mt-20 border-t border-slate-800/80 bg-gradient-to-b from-slate-950 to-[#060a12] py-20 sm:py-24"
  aria-labelledby="contact-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Left Column: How the AI Dynamic Quote & Pilot Closer Works -->
      <div class="lg:col-span-5 space-y-6">
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-300">
          AI Dynamic Scope, ROI &amp; 14-Day Pilot Closer
        </span>

        <h2
          id="contact-heading"
          class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
          data-i18n-en="Get Your Instant AI-Scoped Architecture, ROI & Pilot Quote"
          data-i18n-bm="Dapatkan Pelan Sistem, Anggaran ROI & Sebut Harga Projek Segera"
          data-i18n-zh="一键生成 AI 定制架构方案、ROI 回报测算与精准报价"
        >
          Get Your Instant AI-Scoped Architecture, ROI &amp; Pilot Quote
        </h2>

        <p class="text-sm sm:text-base leading-relaxed text-slate-400">
          Why don’t we use one-size-fits-all price tags? Because a single-outlet cafe and a 20-branch manufacturer have
          completely different needs. Use our <strong class="text-white">AI Scope &amp; Quote Engine</strong> on the right to get an
          <strong class="text-emerald-300">instant, size-matched investment estimate paired with your projected annual savings</strong>.
        </p>

        <!-- How We Remove Risk to Close Deals Fast -->
        <div class="rounded-2xl border border-sky-500/25 bg-slate-900/70 p-5 space-y-3.5">
          <div class="text-xs font-bold uppercase tracking-wider text-sky-400">
            How Our 3-Stage Risk-Free Deal Structure Works
          </div>

          <div class="space-y-3 text-xs">
            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-sky-500/15 font-mono font-bold text-sky-400">
                1
              </span>
              <div>
                <strong class="text-white">Free 3-Document / 10-SKU Live Proof:</strong>
                <span class="text-slate-400">
                  {' '}Send us 3 sample invoices or 10 POS items on WhatsApp—we demonstrate live 99.4% OCR &amp; ERPNext/POS sync before you pay a sen.
                </span>
              </div>
            </div>

            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-emerald-500/15 font-mono font-bold text-emerald-400">
                2
              </span>
              <div>
                <strong class="text-white">Fixed-Fee 14-Day Production Pilot:</strong>
                <span class="text-slate-400">
                  {' '}Start with a low-risk 2-week pilot (1 workflow or 1 outlet). 100% of the pilot fee is credited toward your full rollout if you proceed.
                </span>
              </div>
            </div>

            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-indigo-500/15 font-mono font-bold text-indigo-400">
                3
              </span>
              <div>
                <strong class="text-white">ROI-Backed Milestone Rollout ($0 User License):</strong>
                <span class="text-slate-400">
                  {' '}Pay by verified production milestones with zero recurring per-seat ERPNext license fees.
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Direct Contact Card (Automatically Bound to COMPANY_CONFIG in src/data/siteData.ts) -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5 text-xs space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-bold uppercase tracking-wider text-slate-300">Direct Engineering Desk</span>
            {COMPANY_INFO.ssmRegistrationNo && (
              <span class="font-mono text-[11px] text-slate-400">{COMPANY_INFO.ssmRegistrationNo}</span>
            )}
          </div>
          <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 pt-1 text-slate-300">
            <div>
              <span class="text-slate-500">Email:</span>{' '}
              <a href={`mailto:${COMPANY_INFO.email}`} class="font-semibold text-sky-400 hover:underline">
                {COMPANY_INFO.email}
              </a>
            </div>
            <div>
              <span class="text-slate-500">WhatsApp:</span>{' '}
              <a
                href={`https://wa.me/${COMPANY_INFO.whatsappClean}`}
                target="_blank"
                rel="noopener"
                class="font-semibold text-emerald-400 hover:underline"
              >
                {COMPANY_INFO.whatsapp}
              </a>
            </div>
            <div>
              <span class="text-slate-500">Hub:</span>{' '}
              <span class="font-semibold text-white">
                {COMPANY_INFO.headquarters.city}, {COMPANY_INFO.headquarters.state}, {COMPANY_INFO.headquarters.country}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive AI Dynamic Quote, ROI & Blueprint Form -->
      <div class="lg:col-span-7">
        <form
          id="project-scope-form"
          data-contact-email={COMPANY_INFO.email}
          data-whatsapp-clean={COMPANY_INFO.whatsappClean}
          data-webhook-url={COMPANY_INFO.leadWebhookUrl}
          class="rounded-3xl border border-slate-800 bg-slate-900/75 p-6 sm:p-8 shadow-2xl space-y-6"
        >
          <!-- Quick Industry Preset Buttons -->
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-sky-400">
                Quick-Fill by Industry Scenario (Optional)
              </span>
              <div class="inline-flex rounded-lg border border-slate-800 bg-slate-950 p-0.5 text-[11px]">
                <button
                  type="button"
                  id="quote-curr-myr"
                  class="rounded-md bg-sky-500 px-2.5 py-0.5 font-bold text-slate-950 cursor-pointer"
                >
                  MYR (RM)
                </button>
                <button
                  type="button"
                  id="quote-curr-usd"
                  class="rounded-md px-2.5 py-0.5 font-semibold text-slate-400 hover:text-white cursor-pointer"
                >
                  USD ($)
                </button>
              </div>
            </div>
            <div class="mt-2.5 flex flex-wrap gap-2">
              <button
                type="button"
                data-preset="retail-pos"
                class="preset-btn rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:border-amber-400 hover:text-amber-300 cursor-pointer"
              >
                🏪 Retail / F&amp;B POS + LHDN QR
              </button>
              <button
                type="button"
                data-preset="mfg-erp"
                class="preset-btn rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:border-indigo-400 hover:text-indigo-300 cursor-pointer"
              >
                🏭 Manufacturing ERPNext + AI OCR
              </button>
              <button
                type="button"
                data-preset="dist-bpa"
                class="preset-btn rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:border-emerald-400 hover:text-emerald-300 cursor-pointer"
              >
                🚚 Wholesale + WhatsApp Order Bot
              </button>
              <button
                type="button"
                data-preset="tech-ai"
                class="preset-btn rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:border-sky-400 hover:text-sky-300 cursor-pointer"
              >
                💻 Custom Web/Mobile + AI QA
              </button>
            </div>
          </div>

          <!-- 1. Service Pillars Selection -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300">
              1. Which Service Pillars Do You Need? (Select All That Apply)
            </label>
            <div class="mt-2.5 grid gap-2.5 sm:grid-cols-2">
              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-sky-500/50 has-[:checked]:border-sky-500 has-[:checked]:bg-sky-500/10">
                <input
                  id="chk-ai"
                  type="checkbox"
                  name="pillars"
                  value="AI Services (Coding, Verification, Testing, OCR)"
                  checked
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-sky-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">AI Services &amp; Enterprise OCR</strong>
                  <span class="text-slate-400">AI Coding, Verification, Automated QA, 99.4% OCR</span>
                </span>
              </label>

              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-emerald-500/50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-500/10">
                <input
                  id="chk-bpa"
                  type="checkbox"
                  name="pillars"
                  value="Business Process Automation (BPA)"
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-emerald-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">Business Process Automation</strong>
                  <span class="text-slate-400">3-Way Match, WhatsApp API, n8n / Webhooks</span>
                </span>
              </label>

              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-indigo-500/50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-500/10">
                <input
                  id="chk-erp"
                  type="checkbox"
                  name="pillars"
                  value="Frappe & ERPNext Implementation (LHDN MyInvois)"
                  checked
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-indigo-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">Frappe &amp; ERPNext Implementation</strong>
                  <span class="text-slate-400">Consultation, Migration, LHDN e-Invoicing</span>
                </span>
              </label>

              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-amber-500/50 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/10">
                <input
                  id="chk-pos"
                  type="checkbox"
                  name="pillars"
                  value="POS Software & Point-of-Sale Systems (Retail / F&B)"
                  checked
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-amber-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">POS Software &amp; Retail/F&amp;B Systems</strong>
                  <span class="text-slate-400">Offline-First POS, KDS, LHDN QR &amp; Hardware</span>
                </span>
              </label>

              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-violet-500/50 has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500/10 sm:col-span-2">
                <input
                  id="chk-web"
                  type="checkbox"
                  name="pillars"
                  value="Web & Mobile App Development (SEO/AEO)"
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-violet-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">Web &amp; Mobile App Development (SEO &amp; AEO Engineered)</strong>
                  <span class="text-slate-400">100/100 SEO/AEO Web Platforms, B2B Portals &amp; Cross-Platform Flutter / React Native Mobile Apps</span>
                </span>
              </label>
            </div>
          </div>

          <!-- 2. Operational Scale Qualifiers (Drives Dynamic AI Quote vs ROI) -->
          <div class="grid gap-4 sm:grid-cols-2 rounded-2xl border border-slate-800/90 bg-slate-950/60 p-4">
            <div>
              <label for="input-scale" class="block text-xs font-semibold text-slate-300">
                2. Outlets, Warehouses or Team Size
              </label>
              <select
                id="input-scale"
                name="scale"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-900 px-3 py-2 text-xs sm:text-sm text-white focus:border-sky-500 focus:outline-none"
              >
                <option value="starter">1–2 Outlets / Small Team (&lt;15 Staff)</option>
                <option value="mid" selected>3–8 Outlets / Mid-Market SME (15–80 Staff)</option>
                <option value="enterprise">9+ Outlets / Multi-Company Enterprise (80+ Staff)</option>
              </select>
            </div>

            <div>
              <label for="input-doc-vol" class="block text-xs font-semibold text-slate-300">
                3. Monthly Invoices, Receipts or Orders
              </label>
              <select
                id="input-doc-vol"
                name="docVolume"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-900 px-3 py-2 text-xs sm:text-sm text-white focus:border-sky-500 focus:outline-none"
              >
                <option value="low">Up to 1,000 docs / month</option>
                <option value="med" selected>1,000 – 5,000 docs / month</option>
                <option value="high">5,000 – 25,000+ docs / month</option>
              </select>
            </div>
          </div>

          <!-- 3. Contact Inputs -->
          <div class="grid gap-4 sm:grid-cols-3">
            <div>
              <label for="input-name" class="block text-xs font-semibold text-slate-300">Your Name *</label>
              <input
                id="input-name"
                name="name"
                type="text"
                required
                placeholder="e.g., Daniel Tan"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-sky-500 focus:outline-none"
              />
            </div>

            <div>
              <label for="input-email" class="block text-xs font-semibold text-slate-300">Work Email *</label>
              <input
                id="input-email"
                name="email"
                type="email"
                required
                placeholder="name@company.com"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-sky-500 focus:outline-none"
              />
            </div>

            <div>
              <label for="input-company" class="block text-xs font-semibold text-slate-300">Company Name</label>
              <input
                id="input-company"
                name="company"
                type="text"
                placeholder="e.g., Apex Retail Sdn Bhd"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-sky-500 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="input-details" class="block text-xs font-semibold text-slate-300">
              Current Software (e.g., AutoCount, SQL, SAP, Xero) or Specific Pain Points
            </label>
            <textarea
              id="input-details"
              name="details"
              rows="2"
              placeholder="Tell us what you want to automate or replace..."
              class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2 text-sm text-white placeholder-slate-500 focus:border-sky-500 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-xl bg-gradient-to-r from-sky-500 via-cyan-400 to-emerald-500 px-6 py-3.5 text-sm font-extrabold text-slate-950 shadow-xl shadow-sky-500/20 transition hover:brightness-110 cursor-pointer"
          >
            Calculate My AI Scope Quote, Annual ROI &amp; 14-Day Pilot Plan →
          </button>

          <!-- Instant AI Solution Blueprint, Dynamic Price vs ROI & Multi-Channel Deal Closer Box -->
          <div
            id="form-feedback"
            class="hidden rounded-2xl border border-emerald-500/40 bg-slate-950 p-5 text-xs text-slate-200 space-y-4"
          >
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
              <span class="font-bold text-sm text-emerald-400">
                ✓ AI Scope-Adjusted Quote &amp; ROI Analysis Ready
              </span>
              <span id="webhook-status-badge" class="rounded bg-emerald-500/15 px-2.5 py-0.5 font-mono text-[10px] text-emerald-300">
                100%Pilot-Credit Eligible
              </span>
            </div>

            <!-- Dynamic ROI vs Investment Cards (Solves Both Pricing Concerns Automatically!) -->
            <div class="grid gap-3 sm:grid-cols-3">
              <div class="rounded-xl border border-emerald-500/30 bg-emerald-950/25 p-3">
                <div class="text-[10px] uppercase tracking-wider text-emerald-300 font-semibold">
                  Est. Annual Savings (ROI)
                </div>
                <div id="quote-roi-val" class="mt-1 text-lg font-extrabold text-white">RM 142,000 / yr</div>
                <div class="text-[10px] text-slate-400">Labor + $0 ERP Seat Savings</div>
              </div>

              <div class="rounded-xl border border-sky-500/30 bg-sky-950/25 p-3">
                <div class="text-[10px] uppercase tracking-wider text-sky-300 font-semibold">
                  14-Day Low-Risk Pilot
                </div>
                <div id="quote-pilot-val" class="mt-1 text-lg font-extrabold text-sky-300">RM 6,500</div>
                <div class="text-[10px] text-slate-400">100% Credited to Full Rollout</div>
              </div>

              <div class="rounded-xl border border-indigo-500/30 bg-indigo-950/25 p-3">
                <div class="text-[10px] uppercase tracking-wider text-indigo-300 font-semibold">
                  Full Rollout Estimate
                </div>
                <div id="quote-full-val" class="mt-1 text-lg font-extrabold text-indigo-300">RM 32k – 48k</div>
                <div id="quote-payback-val" class="text-[10px] text-emerald-400 font-semibold">Payback: ~2.8 Months</div>
              </div>
            </div>

            <pre
              id="form-blueprint-preview"
              class="code-scroll max-h-44 overflow-auto rounded-xl border border-slate-800 bg-slate-900/90 p-3.5 font-mono text-[11px] leading-relaxed text-sky-200 whitespace-pre-wrap"
            ></pre>

            <div class="flex flex-wrap gap-2.5 pt-1">
              <a
                id="form-whatsapp-link"
                href="#"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-4 py-2.5 text-xs font-extrabold text-slate-950 transition hover:bg-emerald-400"
              >
                <span>Lock In Pilot &amp; Send via WhatsApp (Fastest)</span>
                <span>→</span>
              </a>

              <a
                id="form-mailto-link"
                href={`mailto:${COMPANY_INFO.email}`}
                class="inline-flex items-center gap-2 rounded-xl border border-sky-500/40 bg-sky-500/15 px-4 py-2.5 text-xs font-bold text-sky-300 transition hover:bg-sky-500/25"
              >
                <span>Send via Email ({COMPANY_INFO.email})</span>
                <span>→</span>
              </a>

              <button
                type="button"
                id="copy-blueprint-btn"
                class="rounded-xl border border-slate-700 bg-slate-900 px-3.5 py-2.5 text-xs font-semibold text-slate-300 hover:text-white cursor-pointer"
              >
                Copy Proposal
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  let quoteCurrency: 'MYR' | 'USD' = 'MYR';

  const form = document.getElementById('project-scope-form') as HTMLFormElement | null;
  const feedback = document.getElementById('form-feedback');
  const blueprintPreview = document.getElementById('form-blueprint-preview');
  const mailtoLink = document.getElementById('form-mailto-link') as HTMLAnchorElement | null;
  const whatsappLink = document.getElementById('form-whatsapp-link') as HTMLAnchorElement | null;
  const copyBlueprintBtn = document.getElementById('copy-blueprint-btn');
  const webhookBadge = document.getElementById('webhook-status-badge');

  const quoteRoiVal = document.getElementById('quote-roi-val');
  const quotePilotVal = document.getElementById('quote-pilot-val');
  const quoteFullVal = document.getElementById('quote-full-val');
  const quotePaybackVal = document.getElementById('quote-payback-val');

  const btnCurrMyr = document.getElementById('quote-curr-myr');
  const btnCurrUsd = document.getElementById('quote-curr-usd');

  const chkAi = document.getElementById('chk-ai') as HTMLInputElement | null;
  const chkBpa = document.getElementById('chk-bpa') as HTMLInputElement | null;
  const chkErp = document.getElementById('chk-erp') as HTMLInputElement | null;
  const chkPos = document.getElementById('chk-pos') as HTMLInputElement | null;
  const chkWeb = document.getElementById('chk-web') as HTMLInputElement | null;
  const scaleSelect = document.getElementById('input-scale') as HTMLSelectElement | null;
  const docVolSelect = document.getElementById('input-doc-vol') as HTMLSelectElement | null;
  const detailsInput = document.getElementById('input-details') as HTMLTextAreaElement | null;

  btnCurrMyr?.addEventListener('click', () => {
    quoteCurrency = 'MYR';
    btnCurrMyr.className = 'rounded-md bg-sky-500 px-2.5 py-0.5 font-bold text-slate-950 cursor-pointer';
    if (btnCurrUsd) btnCurrUsd.className = 'rounded-md px-2.5 py-0.5 font-semibold text-slate-400 hover:text-white cursor-pointer';
  });

  btnCurrUsd?.addEventListener('click', () => {
    quoteCurrency = 'USD';
    btnCurrUsd.className = 'rounded-md bg-sky-500 px-2.5 py-0.5 font-bold text-slate-950 cursor-pointer';
    if (btnCurrMyr) btnCurrMyr.className = 'rounded-md px-2.5 py-0.5 font-semibold text-slate-400 hover:text-white cursor-pointer';
  });

  // Industry Preset Buttons
  document.querySelectorAll('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const preset = btn.getAttribute('data-preset');
      if (!chkAi || !chkBpa || !chkErp || !chkPos || !chkWeb || !scaleSelect || !docVolSelect || !detailsInput) return;

      chkAi.checked = false;
      chkBpa.checked = false;
      chkErp.checked = false;
      chkPos.checked = false;
      chkWeb.checked = false;

      if (preset === 'retail-pos') {
        chkPos.checked = true;
        chkErp.checked = true;
        scaleSelect.value = 'mid';
        docVolSelect.value = 'high';
        detailsInput.value = 'Multi-outlet Retail/F&B POS rollout with offline checkout, LHDN QR receipt self-claim, and ERPNext inventory sync.';
      } else if (preset === 'mfg-erp') {
        chkErp.checked = true;
        chkAi.checked = true;
        chkBpa.checked = true;
        scaleSelect.value = 'mid';
        docVolSelect.value = 'med';
        detailsInput.value = 'Manufacturing BOM/MRP & Multi-Warehouse ERPNext rollout with AI OCR 3-way supplier invoice matching & LHDN MyInvois.';
      } else if (preset === 'dist-bpa') {
        chkBpa.checked = true;
        chkAi.checked = true;
        chkErp.checked = true;
        scaleSelect.value = 'mid';
        docVolSelect.value = 'high';
        detailsInput.value = 'Wholesale distribution automation: WhatsApp B2B order intake bot, AI DO/Invoice OCR, and automated LHDN e-Invoicing.';
      } else if (preset === 'tech-ai') {
        chkAi.checked = true;
        chkWeb.checked = true;
        scaleSelect.value = 'starter';
        docVolSelect.value = 'med';
        detailsInput.value = 'Custom 100/100 SEO/AEO web & Flutter mobile app with deterministic AI code verification & self-healing Playwright QA.';
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const contactEmail = form.getAttribute('data-contact-email') || 'hello@jobshore.com';
    const whatsappClean = form.getAttribute('data-whatsapp-clean') || '60128904210';
    const webhookUrl = form.getAttribute('data-webhook-url') || '';

    const formData = new FormData(form);
    const name = String(formData.get('name') || '');
    const email = String(formData.get('email') || '');
    const company = String(formData.get('company') || 'Enterprise Client');
    const scale = String(formData.get('scale') || 'mid');
    const docVol = String(formData.get('docVolume') || 'med');
    const details = String(formData.get('details') || 'Standard architecture & ROI discovery');
    const selectedPillars = formData.getAll('pillars').map(String);
    const pillarsText = selectedPillars.join(' + ') || 'General Consultation';

    // Calculate Dynamic Scope-Adjusted Investment & ROI
    const scaleMultiplier = scale === 'starter' ? 1 : scale === 'mid' ? 1.85 : 3.2;
    const volBonusRoi = docVol === 'low' ? 28000 : docVol === 'med' ? 74000 : 165000;

    let baseMyrMin = 0;
    const recommendedModules: string[] = [];

    if (selectedPillars.some((p) => p.includes('AI Services'))) {
      baseMyrMin += 12000;
      recommendedModules.push('• Vision-LLM OCR + Deterministic Math/Schema Verification Gate + Self-Healing Playwright QA');
    }
    if (selectedPillars.some((p) => p.includes('Automation'))) {
      baseMyrMin += 10000;
      recommendedModules.push('• Automated 3-Way PO-GRN-Invoice Matching + WhatsApp Cloud API Approval Workflows');
    }
    if (selectedPillars.some((p) => p.includes('ERPNext'))) {
      baseMyrMin += 22000;
      recommendedModules.push('• Frappe ERPNext v15 Core + Real-Time Malaysia LHDN MyInvois API Integration ($0/seat license)');
    }
    if (selectedPillars.some((p) => p.includes('POS'))) {
      baseMyrMin += 7800;
      recommendedModules.push('• Offline-First Retail/F&B POS + LHDN Receipt QR Self-Claim & Monthly Consolidated e-Invoicing');
    }
    if (selectedPillars.some((p) => p.includes('Web & Mobile'))) {
      baseMyrMin += 15000;
      recommendedModules.push('• 100/100 SEO & AEO Web Platform + Cross-Platform Flutter Mobile App');
    }

    if (baseMyrMin === 0) baseMyrMin = 12000;

    const rate = quoteCurrency === 'MYR' ? 1 : 0.23;
    const prefix = quoteCurrency === 'MYR' ? 'RM ' : '$';

    const fullMin = Math.round((baseMyrMin * scaleMultiplier * rate) / 500) * 500;
    const fullMax = Math.round((fullMin * 1.38) / 500) * 500;
    const pilotFee = Math.max(
      quoteCurrency === 'MYR' ? 4800 : 1200,
      Math.round((fullMin * 0.22) / 100) * 100
    );
    const annualRoi = Math.round(((volBonusRoi + baseMyrMin * 2.1 * scaleMultiplier) * rate) / 1000) * 1000;
    const paybackMonths = Math.max(1.4, Number(((fullMin / annualRoi) * 12).toFixed(1)));

    if (quoteRoiVal) quoteRoiVal.textContent = `${prefix}${annualRoi.toLocaleString()} / yr`;
    if (quotePilotVal) quotePilotVal.textContent = `${prefix}${pilotFee.toLocaleString()}`;
    if (quoteFullVal) quoteFullVal.textContent = `${prefix}${(fullMin / 1000).toFixed(1)}k – ${(fullMax / 1000).toFixed(1)}k`;
    if (quotePaybackVal) quotePaybackVal.textContent = `Est. Payback: ~${paybackMonths} Months`;

    const scaleLabel =
      scale === 'starter'
        ? 'Starter (1–2 Outlets / <15 Staff)'
        : scale === 'mid'
          ? 'Mid-Market SME (3–8 Outlets / 15–80 Staff)'
          : 'Enterprise (9+ Outlets / 80+ Staff)';

    const blueprintText = `=== JOBSHORE AI-SCOPED PROPOSAL & PILOT BRIEF ===
Client: ${name} (${company}) | Email: ${email}
Scale Profile: ${scaleLabel}
Selected Pillars: ${pillarsText}

--- FINANCIAL & ROI SUMMARY ---
• Est. Annual Savings (ROI): ${prefix}${annualRoi.toLocaleString()} / year
• Recommended 14-Day Verified Pilot: ${prefix}${pilotFee.toLocaleString()} (100% credited to full rollout)
• Est. Full Milestone Rollout Range: ${prefix}${fullMin.toLocaleString()} – ${prefix}${fullMax.toLocaleString()}
• Projected Payback Window: ~${paybackMonths} Months ($0 per-user ERPNext license fees)

--- RECOMMENDED ARCHITECTURE ---
${recommendedModules.join('\n')}

Client Notes:
${details}

Next Action: Please schedule my free 3-Document / 10-SKU Live Proof & Pilot Kickoff.`;

    if (feedback && blueprintPreview) {
      feedback.classList.remove('hidden');
      blueprintPreview.textContent = blueprintText;
    }

    if (mailtoLink) {
      const subject = encodeURIComponent(`Jobshore AI Quote & Pilot Request: ${company} (${name})`);
      const body = encodeURIComponent(blueprintText);
      mailtoLink.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
    }

    if (whatsappLink) {
      const waText = encodeURIComponent(blueprintText);
      whatsappLink.href = `https://wa.me/${whatsappClean}?text=${waText}`;
    }

    // Optional Automatic Webhook Dispatch (Make.com / n8n / Formspree / Web3Forms)
    if (webhookUrl && webhookUrl.startsWith('http')) {
      try {
        await fetch(webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            email,
            company,
            scale: scaleLabel,
            pillars: selectedPillars,
            currency: quoteCurrency,
            pilotEstimate: pilotFee,
            fullRolloutMin: fullMin,
            fullRolloutMax: fullMax,
            estimatedAnnualRoi: annualRoi,
            details,
            timestamp: new Date().toISOString(),
          }),
        });
        if (webhookBadge) webhookBadge.textContent = '✓ Auto-Sent to Jobshore AI Desk';
      } catch (_) {}
    }
  });

  copyBlueprintBtn?.addEventListener('click', async () => {
    if (blueprintPreview && copyBlueprintBtn) {
      await navigator.clipboard.writeText(blueprintPreview.textContent || '');
      const original = copyBlueprintBtn.textContent;
      copyBlueprintBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBlueprintBtn.textContent = original;
      }, 2000);
    }
  });
</script>
