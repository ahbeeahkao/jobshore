---
import { COMPANY_INFO } from '../data/siteData';

const waUserB64 = Buffer.from(COMPANY_INFO.gatedWhatsappUsername || '').toString('base64');
const waPinB64 = Buffer.from(COMPANY_INFO.gatedWhatsappPin || '').toString('base64');
---

<section
  id="contact"
  class="scroll-mt-20 border-t border-slate-800/80 bg-gradient-to-b from-slate-950 to-[#060a12] py-20 sm:py-24"
  aria-labelledby="contact-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Left Column: How the AI Dynamic Quote & 3-Gate Callback Closer Works -->
      <div class="lg:col-span-5 space-y-6">
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-300">
          AI Dynamic Scope, ROI &amp; 14-Day Pilot Closer
        </span>

        <h2
          id="contact-heading"
          class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
          data-i18n-en="Get Your Instant AI-Scoped Architecture, ROI & Pilot Quote"
          data-i18n-bm="Dapatkan Pelan Sistem, Anggaran ROI & Sebut Harga Projek Segera"
          data-i18n-zh="一键生成 AI 定制架构方案、ROI 回报测算与精准报价"
        >
          Get Your Instant AI-Scoped Architecture, ROI &amp; Pilot Quote
        </h2>

        <p class="text-sm sm:text-base leading-relaxed text-slate-400">
          Why don’t we use one-size-fits-all price tags? Because a single-outlet cafe and a 20-branch manufacturer have
          completely different needs. Use our <strong class="text-white">AI Scope &amp; Quote Engine</strong> on the right to get an
          <strong class="text-emerald-300">instant, size-matched investment estimate paired with your projected annual savings</strong>.
        </p>

        <!-- How We Remove Risk to Close Deals Fast -->
        <div class="rounded-2xl border border-sky-500/25 bg-slate-900/70 p-5 space-y-3.5">
          <div class="text-xs font-bold uppercase tracking-wider text-sky-400">
            How Our 3-Stage Risk-Free Deal Structure Works
          </div>

          <div class="space-y-3 text-xs">
            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-sky-500/15 font-mono font-bold text-sky-400">
                1
              </span>
              <div>
                <strong class="text-white">Free 3-Document / 10-SKU Live Proof:</strong>
                <span class="text-slate-400">
                  {' '}Submit your scope on the right—our Senior Solutions Architect will reach out to run 3 of your sample invoices or 10 POS items live before you pay a sen.
                </span>
              </div>
            </div>

            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-emerald-500/15 font-mono font-bold text-emerald-400">
                2
              </span>
              <div>
                <strong class="text-white">Fixed-Fee 14-Day Production Pilot:</strong>
                <span class="text-slate-400">
                  {' '}Start with a low-risk 2-week pilot (1 workflow, 1 LHDN bridge, or 1 outlet). 100% of the pilot fee is credited toward your full rollout.
                </span>
              </div>
            </div>

            <div class="flex gap-3">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-indigo-500/15 font-mono font-bold text-indigo-400">
                3
              </span>
              <div>
                <strong class="text-white">ROI-Backed Milestone Rollout ($0 User License):</strong>
                <span class="text-slate-400">
                  {' '}Pay by verified production milestones with zero recurring per-seat ERPNext license fees.
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- AI-Era Cost Breakthrough Box (Addresses Past Pre-AI Quotes & Price Objections) -->
        <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-5 space-y-2 text-xs">
          <div class="flex items-center justify-between gap-2">
            <span class="font-bold uppercase tracking-wider text-emerald-400">
              ⚡ Why Our AI-Era Pricing Is 50–65% Lower Than Pre-2024 Quotes
            </span>
            <span class="rounded bg-emerald-500/20 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-300">
              AI Speed + $0 Seat Tax
            </span>
          </div>
          <p class="leading-relaxed text-slate-300">
            Before modern AI engineering and open-source Frappe existed, custom ERP, POS, and mobile systems required months of manual coding—making software expensive. Today, our <strong class="text-white">AI-accelerated build &amp; automated verification pipeline</strong> cuts delivery time and cost by <strong class="text-emerald-300">50–65%</strong>, with <strong class="text-white">$0 per-user license fees</strong>.
            <em class="block mt-1.5 text-sky-300 not-italic font-semibold">
              Received a quote from us years ago? Request a refreshed AI-Era Re-Quote on the right—including a RM 2,000 returning-client pilot credit.
            </em>
          </p>
        </div>

        <!-- 3-Gate Verified Engineering Desk Card (100% Zero Public Phone/WhatsApp Exposure) -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5 text-xs space-y-2.5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-bold uppercase tracking-wider text-slate-200 flex items-center gap-1.5">
              <span class="text-emerald-400">🛡️</span>
              <span>3-Gate Protected Engineering Desk</span>
            </span>
            {COMPANY_INFO.ssmRegistrationNo && (
              <span class="font-mono text-[11px] text-slate-400">{COMPANY_INFO.ssmRegistrationNo}</span>
            )}
          </div>
          <p class="text-slate-400 leading-relaxed">
            To guarantee <strong class="text-slate-200">zero spam and 100% client confidentiality</strong>, we do not expose public phone numbers to web scrapers. Submit your scope through our <strong class="text-emerald-300">3-Gate Verification Form</strong> on the right—our Senior Architect will message your WhatsApp or email directly within 2 business hours.
          </p>
          <div class="pt-1 text-slate-400">
            <span class="text-slate-500">Delivery Hub:</span>{' '}
            <span class="font-semibold text-white">
              {COMPANY_INFO.headquarters.fullAddress}
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive AI Dynamic Quote, 3-Part Anti-Abuse Gate & Webhook Dispatcher -->
      <div class="lg:col-span-7">
        <form
          id="project-scope-form"
          data-webhook-url={COMPANY_INFO.leadWebhookUrl}
          data-fallback-u={COMPANY_INFO.fallbackEmailUser}
          data-fallback-d={COMPANY_INFO.fallbackEmailDomain}
          data-wa-u-b64={waUserB64}
          data-wa-p-b64={waPinB64}
          class="rounded-3xl border border-slate-800 bg-slate-900/75 p-6 sm:p-8 shadow-2xl space-y-6"
        >
          <!-- GATE 1 (PART A): INVISIBLE BOT HONEYPOT TRAP (Hidden from Humans, Traps Automated Scrapers/Bots) -->
          <div class="sr-only" aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;opacity:0;pointer-events:none;">
            <label for="gate-honeypot">Leave this field blank if you are human</label>
            <input
              id="gate-honeypot"
              name="_honeypot"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <!-- Selected Portfolio Architecture Banner (Auto-Shown When Clicking From #portfolio or portfolio.jobshore.dpdns.org) -->
          <div
            id="selected-portfolio-banner"
            class="hidden rounded-2xl border border-emerald-500/40 bg-emerald-950/35 px-4 py-3 text-xs"
          >
            <div class="flex items-start justify-between gap-3">
              <div class="space-y-1">
                <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-emerald-400">
                  📂 Reference Portfolio Architecture Selected
                </div>
                <div id="selected-portfolio-title" class="font-bold text-white"></div>
              </div>
              <button
                type="button"
                id="clear-portfolio-banner"
                class="rounded-lg border border-slate-700 bg-slate-900 px-2 py-0.5 text-[11px] font-semibold text-slate-400 hover:text-white cursor-pointer"
              >
                × Clear
              </button>
            </div>
          </div>

          <!-- Quick Industry Preset Buttons -->
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-sky-400">
                Quick-Fill by Industry Scenario (Optional)
              </span>
              <div class="inline-flex rounded-lg border border-slate-800 bg-slate-950 p-0.5 text-[11px]">
                <button
                  type="button"
                  id="quote-curr-myr"
                  class="rounded-md bg-sky-500 px-2.5 py-0.5 font-bold text-slate-950 cursor-pointer"
                >
                  MYR (RM)
                </button>
                <button
                  type="button"
                  id="quote-curr-usd"
                  class="rounded-md px-2.5 py-0.5 font-semibold text-slate-400 hover:text-white cursor-pointer"
                >
                  USD ($)
                </button>
              </div>
            </div>
            <div class="mt-2.5 flex flex-wrap gap-2">
              <button
                type="button"
                data-preset="retail-pos"
                class="preset-btn rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:border-amber-400 hover:text-amber-300 cursor-pointer"
              >
                🏪 Retail / F&amp;B POS + LHDN QR
              </button>
              <button
                type="button"
                data-preset="mfg-erp"
                class="preset-btn rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:border-indigo-400 hover:text-indigo-300 cursor-pointer"
              >
                🏭 Manufacturing ERPNext + AI OCR
              </button>
              <button
                type="button"
                data-preset="dist-bpa"
                class="preset-btn rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:border-emerald-400 hover:text-emerald-300 cursor-pointer"
              >
                🚚 Wholesale + WhatsApp Order Bot
              </button>
              <button
                type="button"
                data-preset="tech-ai"
                class="preset-btn rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs font-semibold text-slate-300 hover:border-sky-400 hover:text-sky-300 cursor-pointer"
              >
                💻 Custom Web/Mobile + AI QA
              </button>
            </div>
          </div>

          <!-- 1. Service Pillars Selection -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-300">
              1. Which Service Pillars Do You Need? (Select All That Apply)
            </label>
            <div class="mt-2.5 grid gap-2.5 sm:grid-cols-2">
              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-sky-500/50 has-[:checked]:border-sky-500 has-[:checked]:bg-sky-500/10">
                <input
                  id="chk-ai"
                  type="checkbox"
                  name="pillars"
                  value="AI Services (Coding, Verification, Testing, OCR)"
                  checked
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-sky-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">AI Services &amp; Enterprise OCR</strong>
                  <span class="text-slate-400">AI Coding, Verification, Automated QA, 99.4% OCR</span>
                </span>
              </label>

              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-emerald-500/50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-500/10">
                <input
                  id="chk-bpa"
                  type="checkbox"
                  name="pillars"
                  value="Business Process Automation (BPA)"
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-emerald-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">Business Process Automation</strong>
                  <span class="text-slate-400">3-Way Match, WhatsApp API, n8n / Webhooks</span>
                </span>
              </label>

              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-indigo-500/50 has-[:checked]:border-indigo-500 has-[:checked]:bg-indigo-500/10">
                <input
                  id="chk-erp"
                  type="checkbox"
                  name="pillars"
                  value="Frappe & ERPNext Implementation (LHDN MyInvois)"
                  checked
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-indigo-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">Frappe &amp; ERPNext Implementation</strong>
                  <span class="text-slate-400">Consultation, Migration, LHDN e-Invoicing</span>
                </span>
              </label>

              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-amber-500/50 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-500/10">
                <input
                  id="chk-pos"
                  type="checkbox"
                  name="pillars"
                  value="POS Software & Point-of-Sale Systems (Retail / F&B)"
                  checked
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-amber-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">POS Software &amp; Retail/F&amp;B Systems</strong>
                  <span class="text-slate-400">Offline-First POS, KDS, LHDN QR &amp; Hardware</span>
                </span>
              </label>

              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-800 bg-slate-950/80 p-3 transition hover:border-violet-500/50 has-[:checked]:border-violet-500 has-[:checked]:bg-violet-500/10 sm:col-span-2">
                <input
                  id="chk-web"
                  type="checkbox"
                  name="pillars"
                  value="Web & Mobile App Development (SEO/AEO)"
                  class="mt-0.5 h-4 w-4 rounded border-slate-700 accent-violet-400"
                />
                <span class="text-xs">
                  <strong class="block font-bold text-white">Web &amp; Mobile App Development (SEO &amp; AEO Engineered)</strong>
                  <span class="text-slate-400">100/100 SEO/AEO Web Platforms, B2B Portals &amp; Cross-Platform Flutter / React Native Mobile Apps</span>
                </span>
              </label>
            </div>
          </div>

          <!-- 2. Operational Scale Qualifiers -->
          <div class="grid gap-4 sm:grid-cols-3 rounded-2xl border border-slate-800/90 bg-slate-950/60 p-4">
            <div>
              <label for="input-scale" class="block text-xs font-semibold text-slate-300">
                2. Outlets or Team Size
              </label>
              <select
                id="input-scale"
                name="scale"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-900 px-3 py-2 text-xs text-white focus:border-sky-500 focus:outline-none"
              >
                <option value="starter">1–2 Outlets (&lt;15 Staff)</option>
                <option value="mid" selected>3–8 Outlets (15–80 Staff)</option>
                <option value="enterprise">9+ Outlets (80+ Staff)</option>
              </select>
            </div>

            <div>
              <label for="input-doc-vol" class="block text-xs font-semibold text-slate-300">
                3. Monthly Docs / Orders
              </label>
              <select
                id="input-doc-vol"
                name="docVolume"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-900 px-3 py-2 text-xs text-white focus:border-sky-500 focus:outline-none"
              >
                <option value="low">Up to 1,000 docs / mo</option>
                <option value="med" selected>1,000 – 5,000 docs / mo</option>
                <option value="high">5,000 – 25,000+ docs / mo</option>
              </select>
            </div>

            <div>
              <label for="input-timeline" class="block text-xs font-semibold text-slate-300">
                4. Target Timeline
              </label>
              <select
                id="input-timeline"
                name="timeline"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-900 px-3 py-2 text-xs text-white focus:border-sky-500 focus:outline-none"
              >
                <option value="Urgent (Start 14-Day Pilot This Week)" selected>Urgent (Start 14-Day Pilot)</option>
                <option value="Within 30 Days">Within 30 Days</option>
                <option value="Within 60–90 Days (Planning / Grant)">60–90 Days (Planning)</option>
              </select>
            </div>
          </div>

          <!-- GATE 3: CORPORATE LEAD & CALLBACK QUALIFICATION FIELDS (2x2 Grid) -->
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="input-name" class="block text-xs font-semibold text-slate-300">Your Full Name *</label>
              <input
                id="input-name"
                name="name"
                type="text"
                required
                placeholder="e.g., Daniel Tan"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-sky-500 focus:outline-none"
              />
            </div>

            <div>
              <label for="input-company" class="block text-xs font-semibold text-slate-300">Company Name *</label>
              <input
                id="input-company"
                name="company"
                type="text"
                required
                placeholder="e.g., Apex Retail Sdn Bhd"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-sky-500 focus:outline-none"
              />
            </div>

            <div>
              <label for="input-email" class="block text-xs font-semibold text-slate-300">Work Email *</label>
              <input
                id="input-email"
                name="email"
                type="email"
                required
                placeholder="name@company.com"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-sky-500 focus:outline-none"
              />
            </div>

            <div>
              <label for="client-phone" class="block text-xs font-semibold text-emerald-300">
                Your WhatsApp / Mobile No. (For Callback) *
              </label>
              <input
                id="client-phone"
                name="clientPhone"
                type="tel"
                required
                placeholder="e.g., +60 12-345 6789"
                class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 focus:border-emerald-500 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="project-notes" class="block text-xs font-semibold text-slate-300">
              Current Software (e.g., AutoCount, SQL, SAP, Xero) or Specific Pain Points
            </label>
            <textarea
              id="project-notes"
              name="details"
              rows="2"
              placeholder="Tell us what you want to automate or replace..."
              class="mt-1.5 w-full rounded-xl border border-slate-800 bg-slate-950 px-3.5 py-2 text-sm text-white placeholder-slate-500 focus:border-sky-500 focus:outline-none"
            ></textarea>
          </div>

          <!-- GATE 2: INTERACTIVE HUMAN SECURITY CHALLENGE (Blocks Automated Form Spam) -->
          <div class="rounded-2xl border border-slate-800 bg-slate-950/90 p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-2.5">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-sky-500/15 font-mono text-xs font-bold text-sky-400">
                  🛡️
                </span>
                <div>
                  <div class="text-xs font-bold text-white">
                    Anti-Spam Security Gate: <span id="gate-math-prompt" class="text-sky-300 font-mono">What is 7 + 5?</span>
                  </div>
                  <div class="text-[11px] text-slate-400">
                    Protects our engineering queue so real clients get a callback within 2 hours
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <input
                  id="gate-math-input"
                  type="number"
                  required
                  placeholder="Answer"
                  aria-label="Security challenge answer"
                  class="w-24 rounded-xl border border-slate-700 bg-slate-900 px-3 py-1.5 text-center font-mono text-sm font-bold text-white focus:border-emerald-400 focus:outline-none"
                />
                <button
                  type="button"
                  id="gate-math-refresh"
                  title="Generate new challenge"
                  class="rounded-lg border border-slate-800 bg-slate-900 px-2.5 py-1.5 text-xs text-slate-400 hover:text-white cursor-pointer"
                >
                  ↻
                </button>
                <span
                  id="gate-status-pill"
                  class="rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 font-mono text-[10px] font-semibold text-amber-300"
                >
                  🔒 Verify Human
                </span>
              </div>
            </div>
            <p id="gate-error-msg" class="mt-2 hidden text-xs font-semibold text-rose-400"></p>
          </div>

          <button
            id="scope-submit-btn"
            type="submit"
            class="w-full rounded-xl bg-gradient-to-r from-sky-500 via-cyan-400 to-emerald-500 px-6 py-3.5 text-sm font-extrabold text-slate-950 shadow-xl shadow-sky-500/20 transition hover:brightness-110 cursor-pointer"
          >
            Calculate My AI Scope Quote &amp; Dispatch Callback Request →
          </button>

          <!-- Instant AI Solution Blueprint, Dynamic Price vs ROI & Webhook Dispatch Status Box -->
          <div
            id="form-feedback"
            class="hidden rounded-2xl border border-emerald-500/40 bg-slate-950 p-5 text-xs text-slate-200 space-y-4"
          >
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
              <span id="feedback-headline" class="font-bold text-sm text-emerald-400">
                ✓ AI Scope-Adjusted Quote &amp; Callback Request Dispatched
              </span>
              <span id="webhook-status-badge" class="rounded bg-emerald-500/15 px-2.5 py-0.5 font-mono text-[10px] text-emerald-300">
                3-Gate Verified ✓
              </span>
            </div>

            <!-- Dynamic ROI vs Investment Cards -->
            <div class="grid gap-3 sm:grid-cols-3">
              <div class="rounded-xl border border-emerald-500/30 bg-emerald-950/25 p-3">
                <div class="text-[10px] uppercase tracking-wider text-emerald-300 font-semibold">
                  Est. Annual Savings (ROI)
                </div>
                <div id="quote-roi-val" class="mt-1 text-lg font-extrabold text-white">RM 142,000 / yr</div>
                <div class="text-[10px] text-slate-400">Labor + $0 ERP Seat Savings</div>
              </div>

              <div class="rounded-xl border border-sky-500/30 bg-sky-950/25 p-3">
                <div class="text-[10px] uppercase tracking-wider text-sky-300 font-semibold">
                  14-Day Low-Risk Pilot
                </div>
                <div id="quote-pilot-val" class="mt-1 text-lg font-extrabold text-sky-300">RM 6,500</div>
                <div class="text-[10px] text-slate-400">100% Credited to Full Rollout</div>
              </div>

              <div class="rounded-xl border border-indigo-500/30 bg-indigo-950/25 p-3">
                <div class="text-[10px] uppercase tracking-wider text-indigo-300 font-semibold">
                  Full Rollout Estimate
                </div>
                <div id="quote-full-val" class="mt-1 text-lg font-extrabold text-indigo-300">RM 32k – 48k</div>
                <div id="quote-payback-val" class="text-[10px] text-emerald-400 font-semibold">Payback: ~2.8 Months</div>
              </div>
            </div>

            <div
              id="webhook-delivery-banner"
              class="rounded-xl border border-emerald-500/30 bg-emerald-950/30 p-3.5 text-xs text-slate-200 leading-relaxed"
            >
              <strong class="text-emerald-300">✓ Callback Queued:</strong> Your scope blueprint and contact number have been securely logged. A Senior Jobshore Solutions Architect will reach out to your WhatsApp / Email shortly to arrange your <strong class="text-white">Free 3-Document / 10-SKU Live Proof</strong>.
            </div>

            <!-- OPTION B (STACKED ON TOP OF OPTION A): Gated Post-Submission WhatsApp @username + 4-Digit PIN -->
            <!-- Decoded in JS ONLY AFTER the human passes all 3 Anti-Abuse Gates & submits their callback number -->
            <div
              id="gated-wa-fasttrack-box"
              class="hidden rounded-xl border border-sky-500/35 bg-sky-950/30 p-4 text-xs space-y-2.5"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-bold uppercase tracking-wider text-sky-300 flex items-center gap-1.5">
                  <span>⚡</span>
                  <span>Fast-Track Option (Unlocked After 3-Gate Verification)</span>
                </span>
                <span class="rounded bg-emerald-500/20 px-2 py-0.5 font-mono text-[10px] font-bold text-emerald-300">
                  Zero Phone Exposure • Privacy Protected
                </span>
              </div>
              <p class="text-slate-300 leading-relaxed">
                Want to send us your <strong class="text-white">3 sample invoices, POS items, or screenshots immediately</strong> without waiting for our callback? Open WhatsApp, search for our verified Architect Username below, and include your <strong class="text-emerald-300">4-Digit Access PIN</strong>:
              </p>
              <div class="flex flex-wrap items-center gap-2.5 pt-0.5">
                <div class="inline-flex items-center gap-2 rounded-lg border border-sky-500/40 bg-slate-950 px-3 py-1.5">
                  <span class="text-slate-400">WhatsApp Username:</span>
                  <code id="unlocked-wa-username" class="font-mono text-sm font-extrabold text-sky-300"></code>
                </div>
                <div id="unlocked-wa-pin-pill" class="inline-flex items-center gap-2 rounded-lg border border-emerald-500/40 bg-slate-950 px-3 py-1.5">
                  <span class="text-slate-400">Access PIN:</span>
                  <code id="unlocked-wa-pin" class="font-mono text-sm font-extrabold text-emerald-300"></code>
                </div>
                <button
                  type="button"
                  id="copy-wa-username-btn"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-sky-500/40 bg-sky-500/15 px-3 py-1.5 font-bold text-sky-300 hover:bg-sky-500/25 cursor-pointer"
                >
                  <span>📋 Copy @username + PIN</span>
                </button>
              </div>
            </div>

            <pre
              id="form-blueprint-preview"
              class="code-scroll max-h-44 overflow-auto rounded-xl border border-slate-800 bg-slate-900/90 p-3.5 font-mono text-[11px] leading-relaxed text-sky-200 whitespace-pre-wrap"
            ></pre>

            <div class="flex flex-wrap items-center justify-between gap-2.5 pt-1">
              <button
                type="button"
                id="copy-blueprint-btn"
                class="inline-flex items-center gap-2 rounded-xl bg-emerald-500 px-4 py-2.5 text-xs font-extrabold text-slate-950 transition hover:bg-emerald-400 cursor-pointer"
              >
                <span>📋 Copy My Proposal Blueprint</span>
              </button>

              <span id="lead-ref-code" class="font-mono text-[11px] text-slate-400">
                Ref: #JS-PENDING
              </span>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  let quoteCurrency: 'MYR' | 'USD' = 'MYR';

  // ==========================================================================
  // 3-PART ANTI-ABUSE GATE STATE
  // ==========================================================================
  const pageLoadTs = Date.now();
  let humanInteracted = false;
  let challengeA = 7;
  let challengeB = 5;
  let challengeVerified = false;

  const markInteracted = () => {
    humanInteracted = true;
  };
  window.addEventListener('mousemove', markInteracted, { once: true, passive: true });
  window.addEventListener('touchstart', markInteracted, { once: true, passive: true });
  window.addEventListener('keydown', markInteracted, { once: true, passive: true });

  const mathPrompt = document.getElementById('gate-math-prompt');
  const mathInput = document.getElementById('gate-math-input') as HTMLInputElement | null;
  const mathRefresh = document.getElementById('gate-math-refresh');
  const statusPill = document.getElementById('gate-status-pill');
  const gateErrorMsg = document.getElementById('gate-error-msg');
  const honeypotInput = document.getElementById('gate-honeypot') as HTMLInputElement | null;

  function getActiveLang(): 'en' | 'bm' | 'zh' {
    const fn = (window as any).__jobshoreGetLang;
    return fn ? fn() : 'en';
  }

  function updateChallengeLabels() {
    const lang = getActiveLang();
    if (mathPrompt) {
      mathPrompt.textContent =
        lang === 'bm'
          ? `Berapakah ${challengeA} + ${challengeB}?`
          : lang === 'zh'
            ? `请问 ${challengeA} + ${challengeB} 等于多少？`
            : `What is ${challengeA} + ${challengeB}?`;
    }
    if (statusPill) {
      if (challengeVerified) {
        statusPill.textContent =
          lang === 'bm' ? '✓ Manusia Disahkan' : lang === 'zh' ? '✓ 真人已验证' : '✓ Human Verified';
      } else {
        statusPill.textContent =
          lang === 'bm' ? '🔒 Pengesahan Manusia' : lang === 'zh' ? '🔒 真人安全验证' : '🔒 Verify Human';
      }
    }
  }

  function generateChallenge() {
    challengeA = Math.floor(Math.random() * 8) + 3; // 3..10
    challengeB = Math.floor(Math.random() * 8) + 2; // 2..9
    challengeVerified = false;
    if (mathInput) mathInput.value = '';
    if (statusPill) {
      statusPill.className =
        'rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 font-mono text-[10px] font-semibold text-amber-300';
    }
    updateChallengeLabels();
  }

  generateChallenge();

  window.addEventListener('jobshore:langchange', updateChallengeLabels);

  mathRefresh?.addEventListener('click', generateChallenge);

  mathInput?.addEventListener('input', () => {
    const val = Number(mathInput.value);
    if (val === challengeA + challengeB) {
      challengeVerified = true;
      if (statusPill) {
        statusPill.className =
          'rounded-full border border-emerald-500/40 bg-emerald-500/15 px-2.5 py-1 font-mono text-[10px] font-bold text-emerald-300';
      }
      if (gateErrorMsg) gateErrorMsg.classList.add('hidden');
    } else {
      challengeVerified = false;
      if (statusPill) {
        statusPill.className =
          'rounded-full border border-amber-500/30 bg-amber-500/10 px-2.5 py-1 font-mono text-[10px] font-semibold text-amber-300';
      }
    }
    updateChallengeLabels();
  });

  // ==========================================================================
  // FORM & DYNAMIC QUOTE CALCULATOR ELEMENTS
  // ==========================================================================
  const form = document.getElementById('project-scope-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('scope-submit-btn') as HTMLButtonElement | null;
  const feedback = document.getElementById('form-feedback');
  const blueprintPreview = document.getElementById('form-blueprint-preview');
  const copyBlueprintBtn = document.getElementById('copy-blueprint-btn');
  const webhookBadge = document.getElementById('webhook-status-badge');
  const webhookBanner = document.getElementById('webhook-delivery-banner');
  const leadRefCode = document.getElementById('lead-ref-code');

  const quoteRoiVal = document.getElementById('quote-roi-val');
  const quotePilotVal = document.getElementById('quote-pilot-val');
  const quoteFullVal = document.getElementById('quote-full-val');
  const quotePaybackVal = document.getElementById('quote-payback-val');

  const btnCurrMyr = document.getElementById('quote-curr-myr');
  const btnCurrUsd = document.getElementById('quote-curr-usd');

  const chkAi = document.getElementById('chk-ai') as HTMLInputElement | null;
  const chkBpa = document.getElementById('chk-bpa') as HTMLInputElement | null;
  const chkErp = document.getElementById('chk-erp') as HTMLInputElement | null;
  const chkPos = document.getElementById('chk-pos') as HTMLInputElement | null;
  const chkWeb = document.getElementById('chk-web') as HTMLInputElement | null;
  const scaleSelect = document.getElementById('input-scale') as HTMLSelectElement | null;
  const docVolSelect = document.getElementById('input-doc-vol') as HTMLSelectElement | null;
  const detailsInput = document.getElementById('project-notes') as HTMLTextAreaElement | null;

  btnCurrMyr?.addEventListener('click', () => {
    quoteCurrency = 'MYR';
    btnCurrMyr.className = 'rounded-md bg-sky-500 px-2.5 py-0.5 font-bold text-slate-950 cursor-pointer';
    if (btnCurrUsd) btnCurrUsd.className = 'rounded-md px-2.5 py-0.5 font-semibold text-slate-400 hover:text-white cursor-pointer';
  });

  btnCurrUsd?.addEventListener('click', () => {
    quoteCurrency = 'USD';
    btnCurrUsd.className = 'rounded-md bg-sky-500 px-2.5 py-0.5 font-bold text-slate-950 cursor-pointer';
    if (btnCurrMyr) btnCurrMyr.className = 'rounded-md px-2.5 py-0.5 font-semibold text-slate-400 hover:text-white cursor-pointer';
  });

  // Industry Preset Buttons
  document.querySelectorAll('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const preset = btn.getAttribute('data-preset');
      if (!chkAi || !chkBpa || !chkErp || !chkPos || !chkWeb || !scaleSelect || !docVolSelect || !detailsInput) return;

      chkAi.checked = false;
      chkBpa.checked = false;
      chkErp.checked = false;
      chkPos.checked = false;
      chkWeb.checked = false;

      const lang = getActiveLang();
      if (preset === 'retail-pos') {
        chkPos.checked = true;
        chkErp.checked = true;
        scaleSelect.value = 'mid';
        docVolSelect.value = 'high';
        detailsInput.value =
          lang === 'bm'
            ? 'Pelaksanaan POS Runcit/F&B pelbagai cawangan dengan kaunter luar talian, tuntutan kendiri QR resit LHDN, dan penyegerakan inventori ERPNext.'
            : lang === 'zh'
              ? '多门店零售/餐饮 POS 部署：包含断网离线收银、LHDN 小票扫码自助开票及 ERPNext 实时库存同步。'
              : 'Multi-outlet Retail/F&B POS rollout with offline checkout, LHDN QR receipt self-claim, and ERPNext inventory sync.';
      } else if (preset === 'mfg-erp') {
        chkErp.checked = true;
        chkAi.checked = true;
        chkBpa.checked = true;
        scaleSelect.value = 'mid';
        docVolSelect.value = 'med';
        detailsInput.value =
          lang === 'bm'
            ? 'Pelaksanaan ERPNext Pembuatan BOM/MRP & Pelbagai Gudang dengan padanan invois pembekal 3-hala AI OCR & LHDN MyInvois.'
            : lang === 'zh'
              ? '生产制造 BOM/MRP 与多仓库 ERPNext 实施：搭配 AI OCR 采购三单自动匹配与 LHDN MyInvois 电子发票。'
              : 'Manufacturing BOM/MRP & Multi-Warehouse ERPNext rollout with AI OCR 3-way supplier invoice matching & LHDN MyInvois.';
      } else if (preset === 'dist-bpa') {
        chkBpa.checked = true;
        chkAi.checked = true;
        chkErp.checked = true;
        scaleSelect.value = 'mid';
        docVolSelect.value = 'high';
        detailsInput.value =
          lang === 'bm'
            ? 'Automasi pengedaran borong: bot pesanan B2B WhatsApp, AI OCR DO/Invois, dan e-Invois LHDN automatik.'
            : lang === 'zh'
              ? '批发分销全流程自动化：WhatsApp B2B 自动接单机器人、AI 送货单/发票 OCR 识别及 LHDN 电子发票自动上报。'
              : 'Wholesale distribution automation: WhatsApp B2B order intake bot, AI DO/Invoice OCR, and automated LHDN e-Invoicing.';
      } else if (preset === 'tech-ai') {
        chkAi.checked = true;
        chkWeb.checked = true;
        scaleSelect.value = 'starter';
        docVolSelect.value = 'med';
        detailsInput.value =
          lang === 'bm'
            ? 'Aplikasi web SEO/AEO 100/100 & mudah alih Flutter tersuai dengan pengesahan kod AI deterministik & QA Playwright penyembuhan kendiri.'
            : lang === 'zh'
              ? '定制 100/100 满分 SEO/AEO 网站与 Flutter 移动应用，结合确定性 AI 代码验证与自愈式 Playwright 自动化测试。'
              : 'Custom 100/100 SEO/AEO web & Flutter mobile app with deterministic AI code verification & self-healing Playwright QA.';
      }
    });
  });

  // ========================================================================
  // PORTFOLIO-TO-QUOTE BRIDGE (#portfolio clicks + ?project= URL from portfolio.jobshore.dpdns.org)
  // ========================================================================
  const portfolioBanner = document.getElementById('selected-portfolio-banner');
  const portfolioBannerTitle = document.getElementById('selected-portfolio-title');
  const clearPortfolioBannerBtn = document.getElementById('clear-portfolio-banner');

  function applyPortfolioSelection(projectTitle: string, categoryOrPillar: string, clientLabel = '') {
    if (!projectTitle) return;
    humanInteracted = true;

    const fullLabel = clientLabel ? `${clientLabel} — ${projectTitle}` : projectTitle;
    if (portfolioBanner && portfolioBannerTitle) {
      portfolioBannerTitle.textContent = fullLabel;
      portfolioBanner.classList.remove('hidden');
    }

    const catLower = (categoryOrPillar + ' ' + projectTitle).toLowerCase();
    if (chkAi && chkBpa && chkErp && chkPos && chkWeb) {
      chkAi.checked = false;
      chkBpa.checked = false;
      chkErp.checked = false;
      chkPos.checked = false;
      chkWeb.checked = false;

      if (catLower.includes('pos') || catLower.includes('retail') || catLower.includes('f&b') || catLower.includes('receipt')) {
        chkPos.checked = true;
        chkErp.checked = true;
      }
      if (catLower.includes('erp') || catLower.includes('frappe') || catLower.includes('lhdn') || catLower.includes('manufacturing')) {
        chkErp.checked = true;
        chkAi.checked = true;
      }
      if (catLower.includes('automation') || catLower.includes('bpa') || catLower.includes('whatsapp')) {
        chkBpa.checked = true;
        chkAi.checked = true;
      }
      if (catLower.includes('web') || catLower.includes('mobile') || catLower.includes('flutter') || catLower.includes('portal')) {
        chkWeb.checked = true;
      }
      if (catLower.includes('ai') || catLower.includes('ocr') || catLower.includes('verif') || catLower.includes('test')) {
        chkAi.checked = true;
      }
      if (!chkAi.checked && !chkBpa.checked && !chkErp.checked && !chkPos.checked && !chkWeb.checked) {
        chkAi.checked = true;
        chkErp.checked = true;
      }
    }

    if (detailsInput) {
      detailsInput.value = `[Reference Portfolio Project]: ${fullLabel} — Requesting a live walkthrough & 14-day pilot scope for a similar setup.`;
    }
  }

  clearPortfolioBannerBtn?.addEventListener('click', () => {
    portfolioBanner?.classList.add('hidden');
  });

  window.addEventListener('jobshore:select-portfolio-project', (ev: any) => {
    const d = ev?.detail || {};
    applyPortfolioSelection(d.project || '', d.category || '', d.client || '');
  });

  // Also check URL query parameters (?project=...&pillar=...) when arriving from https://portfolio.jobshore.dpdns.org
  try {
    const params = new URLSearchParams(window.location.search);
    const urlProject = params.get('project') || params.get('sample') || '';
    const urlPillar = params.get('pillar') || params.get('category') || '';
    if (urlProject) {
      applyPortfolioSelection(urlProject.replace(/[-_]+/g, ' '), urlPillar);
    }
  } catch (_) {}

  function showGateError(msg: string) {
    if (gateErrorMsg) {
      gateErrorMsg.textContent = msg;
      gateErrorMsg.classList.remove('hidden');
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (gateErrorMsg) gateErrorMsg.classList.add('hidden');

    const webhookUrl = (form.getAttribute('data-webhook-url') || '').trim();
    const dwellTimeSec = Math.round((Date.now() - pageLoadTs) / 1000);

    // ========================================================================
    // ENFORCE 3-PART ANTI-ABUSE GATE BEFORE CALCULATING OR DISPATCHING
    // ========================================================================
    // Gate 1: Invisible Honeypot & Minimum Human Dwell Check
    if (honeypotInput && honeypotInput.value.trim() !== '') {
      return; // Silently drop bot submission
    }
    if (!humanInteracted || dwellTimeSec < 2) {
      showGateError('Security Gate 1: Please interact with the form naturally before submitting.');
      return;
    }

    // Gate 2: Interactive Math Security Challenge
    if (!challengeVerified) {
      showGateError(`Security Gate 2: Please enter the correct sum (${challengeA} + ${challengeB} = ${challengeA + challengeB}).`);
      mathInput?.focus();
      return;
    }

    // Gate 3: Corporate Lead & Callback Qualification + 60s Rate-Limit Cooldown
    const formData = new FormData(form);
    const name = String(formData.get('name') || '').trim();
    const email = String(formData.get('email') || '').trim();
    const company = String(formData.get('company') || '').trim();
    const clientPhone = String(formData.get('clientPhone') || '').trim();
    const phoneDigitsOnly = clientPhone.replace(/[^0-9]/g, '');

    if (phoneDigitsOnly.length < 8) {
      showGateError('Security Gate 3: Please enter a valid mobile or WhatsApp number (at least 8 digits) so our Architect can reach you.');
      return;
    }

    try {
      const lastSubmit = Number(localStorage.getItem('jobshore_last_submit_ts') || '0');
      const elapsedSec = Math.round((Date.now() - lastSubmit) / 1000);
      if (lastSubmit > 0 && elapsedSec < 45) {
        showGateError(`Rate Limit Protection: Please wait ${45 - elapsedSec} seconds before sending another request.`);
        return;
      }
    } catch (_) {}

    const scale = String(formData.get('scale') || 'mid');
    const docVol = String(formData.get('docVolume') || 'med');
    const timeline = String(formData.get('timeline') || 'Urgent (Start 14-Day Pilot)');
    const details = String(formData.get('details') || 'Standard architecture & ROI discovery');
    const selectedPillars = formData.getAll('pillars').map(String);
    const pillarsText = selectedPillars.join(' + ') || 'General Consultation';

    // Calculate Dynamic Scope-Adjusted Investment & ROI
    const scaleMultiplier = scale === 'starter' ? 1 : scale === 'mid' ? 1.85 : 3.2;
    const volBonusRoi = docVol === 'low' ? 28000 : docVol === 'med' ? 74000 : 165000;

    let baseMyrMin = 0;
    const recommendedModules: string[] = [];

    if (selectedPillars.some((p) => p.includes('AI Services'))) {
      baseMyrMin += 12000;
      recommendedModules.push('• Vision-LLM OCR + Deterministic Math/Schema Verification Gate + Self-Healing Playwright QA');
    }
    if (selectedPillars.some((p) => p.includes('Automation'))) {
      baseMyrMin += 10000;
      recommendedModules.push('• Automated 3-Way PO-GRN-Invoice Matching + WhatsApp Cloud API Approval Workflows');
    }
    if (selectedPillars.some((p) => p.includes('ERPNext'))) {
      baseMyrMin += 22000;
      recommendedModules.push('• Frappe ERPNext v15 Core + Real-Time Malaysia LHDN MyInvois API Integration ($0/seat license)');
    }
    if (selectedPillars.some((p) => p.includes('POS'))) {
      baseMyrMin += 7800;
      recommendedModules.push('• Offline-First Retail/F&B POS + LHDN Receipt QR Self-Claim & Monthly Consolidated e-Invoicing');
    }
    if (selectedPillars.some((p) => p.includes('Web & Mobile'))) {
      baseMyrMin += 15000;
      recommendedModules.push('• 100/100 SEO & AEO Web Platform + Cross-Platform Flutter Mobile App');
    }

    if (baseMyrMin === 0) baseMyrMin = 12000;

    const rate = quoteCurrency === 'MYR' ? 1 : 0.23;
    const prefix = quoteCurrency === 'MYR' ? 'RM ' : '$';

    const fullMin = Math.round((baseMyrMin * scaleMultiplier * rate) / 500) * 500;
    const fullMax = Math.round((fullMin * 1.38) / 500) * 500;
    const pilotFee = Math.max(
      quoteCurrency === 'MYR' ? 4800 : 1200,
      Math.round((fullMin * 0.22) / 100) * 100
    );
    const annualRoi = Math.round(((volBonusRoi + baseMyrMin * 2.1 * scaleMultiplier) * rate) / 1000) * 1000;
    const paybackMonths = Math.max(1.4, Number(((fullMin / annualRoi) * 12).toFixed(1)));

    const pilotFormatted = `${prefix}${pilotFee.toLocaleString()}`;
    const fullFormatted = `${prefix}${fullMin.toLocaleString()} – ${prefix}${fullMax.toLocaleString()}`;
    const savingsFormatted = `${prefix}${annualRoi.toLocaleString()} / yr`;

    if (quoteRoiVal) quoteRoiVal.textContent = savingsFormatted;
    if (quotePilotVal) quotePilotVal.textContent = pilotFormatted;
    if (quoteFullVal) quoteFullVal.textContent = `${prefix}${(fullMin / 1000).toFixed(1)}k – ${(fullMax / 1000).toFixed(1)}k`;
    if (quotePaybackVal) quotePaybackVal.textContent = `Est. Payback: ~${paybackMonths} Months`;

    const scaleLabel =
      scale === 'starter'
        ? 'Starter (1–2 Outlets / <15 Staff)'
        : scale === 'mid'
          ? 'Mid-Market SME (3–8 Outlets / 15–80 Staff)'
          : 'Enterprise (9+ Outlets / 80+ Staff)';

    const leadId = `JS-${Math.floor(100000 + Math.random() * 900000)}`;
    if (leadRefCode) leadRefCode.textContent = `Lead Ref: #${leadId}`;

    const blueprintText = `=== JOBSHORE AI-SCOPED PROPOSAL & PILOT BRIEF (${leadId}) ===
Client: ${name} (${company})
Work Email: ${email} | Callback WhatsApp/Phone: ${clientPhone}
Scale Profile: ${scaleLabel} | Target Timeline: ${timeline}
Selected Pillars: ${pillarsText}

--- FINANCIAL & ROI SUMMARY ---
• Est. Annual Savings (ROI): ${savingsFormatted}
• Recommended 14-Day Verified Pilot: ${pilotFormatted} (100% credited to full rollout)
• Est. Full Milestone Rollout Range: ${fullFormatted}
• Projected Payback Window: ~${paybackMonths} Months ($0 per-user ERPNext license fees)

--- RECOMMENDED ARCHITECTURE ---
${recommendedModules.join('\n')}

Client Notes:
${details}`;

    if (feedback && blueprintPreview) {
      feedback.classList.remove('hidden');
      blueprintPreview.textContent = blueprintText;
    }

    // ========================================================================
    // OPTION B (STACKED ON TOP OF OPTION A): UNLOCK GATED WHATSAPP @USERNAME + PIN
    // Decoded at runtime ONLY AFTER Gate 1, Gate 2, and Gate 3 succeed
    // ========================================================================
    const waFastTrackBox = document.getElementById('gated-wa-fasttrack-box');
    const waUserEl = document.getElementById('unlocked-wa-username');
    const waPinEl = document.getElementById('unlocked-wa-pin');
    const waPinPill = document.getElementById('unlocked-wa-pin-pill');
    const waUserB64Attr = (form.getAttribute('data-wa-u-b64') || '').trim();
    const waPinB64Attr = (form.getAttribute('data-wa-p-b64') || '').trim();

    if (waUserB64Attr && waFastTrackBox && waUserEl) {
      try {
        const decodedUser = atob(waUserB64Attr);
        const decodedPin = waPinB64Attr ? atob(waPinB64Attr) : '';
        if (decodedUser) {
          waUserEl.textContent = decodedUser;
          if (decodedPin && waPinEl) {
            waPinEl.textContent = decodedPin;
            waPinPill?.classList.remove('hidden');
          } else {
            waPinPill?.classList.add('hidden');
          }
          waFastTrackBox.classList.remove('hidden');
        }
      } catch (_) {}
    }

    // Record cooldown timestamp & rotate challenge
    try {
      localStorage.setItem('jobshore_last_submit_ts', String(Date.now()));
    } catch (_) {}
    generateChallenge();

    // ========================================================================
    // DISPATCH TO GOOGLE APPS SCRIPT WEBHOOK (CORS-SAFE text/plain POST)
    // ========================================================================
    const payload = {
      leadId,
      name,
      company,
      email,
      clientPhone,
      pillars: pillarsText,
      scale: scaleLabel,
      timeline,
      pilotQuote: pilotFormatted,
      fullQuote: fullFormatted,
      annualSavings: savingsFormatted,
      notes: details,
      _honeypot: honeypotInput?.value || '',
      dwellTimeSec,
      humanInteracted,
      challengeVerified: true,
      timestamp: new Date().toISOString(),
    };

    if (webhookUrl && webhookUrl.startsWith('http')) {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Dispatching Verified Scope to Engineering Desk...';
      }
      if (webhookBadge) webhookBadge.textContent = 'Sending to Google Apps Script...';

      try {
        // Using text/plain;charset=utf-8 avoids CORS OPTIONS preflight errors on Google Apps Script!
        await fetch(webhookUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });
        if (webhookBadge) webhookBadge.textContent = `✓ Sent to Engineering Desk (#${leadId})`;
        if (webhookBanner) {
          webhookBanner.innerHTML = `<strong class="text-emerald-300">✓ Dispatched via Webhook (#${leadId}):</strong> Your scope, ROI analysis, and callback number (<strong class="text-white">${clientPhone}</strong>) have been logged to our engineering queue. A Senior Architect will message your WhatsApp / Email within 2 business hours.`;
        }
      } catch (_) {
        if (webhookBadge) webhookBadge.textContent = `✓ Scope Generated (#${leadId})`;
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '✓ Scope & Callback Dispatched (Calculate Another)';
        }
      }
    } else {
      if (webhookBadge) webhookBadge.textContent = `✓ 3-Gate Verified (#${leadId})`;
      if (webhookBanner) {
        webhookBanner.innerHTML = `<strong class="text-emerald-300">✓ Callback Request Logged (#${leadId}):</strong> Your scope blueprint and callback number (<strong class="text-white">${clientPhone}</strong>) have been verified. A Senior Jobshore Solutions Architect will reach out to arrange your <strong class="text-white">Free 3-Document / 10-SKU Live Proof</strong>.`;
      }
    }
  });

  copyBlueprintBtn?.addEventListener('click', async () => {
    if (blueprintPreview && copyBlueprintBtn) {
      await navigator.clipboard.writeText(blueprintPreview.textContent || '');
      const original = copyBlueprintBtn.textContent;
      copyBlueprintBtn.textContent = '✓ Copied to Clipboard!';
      setTimeout(() => {
        copyBlueprintBtn.textContent = original;
      }, 2000);
    }
  });

  const copyWaUsernameBtn = document.getElementById('copy-wa-username-btn');
  copyWaUsernameBtn?.addEventListener('click', async () => {
    const waUserEl = document.getElementById('unlocked-wa-username');
    const waPinEl = document.getElementById('unlocked-wa-pin');
    const u = waUserEl?.textContent?.trim() || '';
    const p = waPinEl?.textContent?.trim() || '';
    const ref = leadRefCode?.textContent?.trim() || '';
    const textToCopy = p ? `${u} (Access PIN: ${p}) — ${ref}` : `${u} — ${ref}`;
    await navigator.clipboard.writeText(textToCopy);
    const original = copyWaUsernameBtn.textContent;
    copyWaUsernameBtn.textContent = '✓ Copied @username + PIN!';
    setTimeout(() => {
      copyWaUsernameBtn.textContent = original;
    }, 2000);
  });
</script>
