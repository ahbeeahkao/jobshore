---
---

<section
  id="roi-calculator"
  class="scroll-mt-20 border-y border-slate-800/80 bg-slate-950/90 py-20 sm:py-24"
  aria-labelledby="roi-calculator-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <!-- Left Column: Interactive Sliders -->
      <div class="lg:col-span-7 space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-300">
            Interactive ROI &amp; TCO Estimator
          </span>

          <!-- Currency Toggle (MYR / USD) -->
          <div class="inline-flex rounded-xl border border-slate-800 bg-slate-900 p-1">
            <button
              type="button"
              id="roi-curr-myr"
              class="rounded-lg bg-sky-500 px-3 py-1 text-xs font-bold text-slate-950 transition cursor-pointer"
            >
              MYR (RM)
            </button>
            <button
              type="button"
              id="roi-curr-usd"
              class="rounded-lg px-3 py-1 text-xs font-semibold text-slate-300 transition hover:text-white cursor-pointer"
            >
              USD ($)
            </button>
          </div>
        </div>

        <h2 id="roi-calculator-heading" class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          Calculate Your Annual Savings from AI OCR, Workflow Automation &amp; ERPNext
        </h2>
        <p class="text-sm sm:text-base text-slate-400">
          Adjust the sliders below to estimate the hours reclaimed and annual software + operational savings when
          combining Jobshore’s <strong class="text-white">99.4% AI OCR</strong>, <strong class="text-white">Business Process Automation</strong>, and
          <strong class="text-white">$0-license Frappe ERPNext</strong>.
        </p>

        <!-- Sliders Box -->
        <div class="space-y-6 rounded-2xl border border-slate-800 bg-slate-900/70 p-6">
          <!-- Slider 1: Monthly Documents -->
          <div>
            <div class="flex justify-between text-xs sm:text-sm font-semibold">
              <label for="slider-docs" class="text-slate-200">
                1. Monthly Invoices, POs, DOs &amp; Receipts Processed
              </label>
              <span id="label-docs" class="font-mono font-bold text-sky-400">2,500 docs / mo</span>
            </div>
            <input
              id="slider-docs"
              type="range"
              min="200"
              max="20000"
              step="100"
              value="2500"
              class="mt-2.5 h-2 w-full cursor-pointer appearance-none rounded-lg bg-slate-800 accent-sky-400"
            />
            <div class="mt-1 flex justify-between text-[11px] text-slate-500">
              <span>200 docs/mo</span>
              <span>10,000 docs/mo</span>
              <span>20,000 docs/mo</span>
            </div>
          </div>

          <!-- Slider 2: Ops/Finance Staff -->
          <div>
            <div class="flex justify-between text-xs sm:text-sm font-semibold">
              <label for="slider-staff" class="text-slate-200">
                2. Staff Handling Manual Entry, Approvals &amp; Reconciliation
              </label>
              <span id="label-staff" class="font-mono font-bold text-emerald-400">6 staff</span>
            </div>
            <input
              id="slider-staff"
              type="range"
              min="1"
              max="40"
              step="1"
              value="6"
              class="mt-2.5 h-2 w-full cursor-pointer appearance-none rounded-lg bg-slate-800 accent-emerald-400"
            />
            <div class="mt-1 flex justify-between text-[11px] text-slate-500">
              <span>1 staff</span>
              <span>20 staff</span>
              <span>40 staff</span>
            </div>
          </div>

          <!-- Slider 3: Active ERP Users -->
          <div>
            <div class="flex justify-between text-xs sm:text-sm font-semibold">
              <label for="slider-users" class="text-slate-200">
                3. Active ERP / System Users (ERPNext $0 Per-Seat Savings)
              </label>
              <span id="label-users" class="font-mono font-bold text-indigo-400">35 users</span>
            </div>
            <input
              id="slider-users"
              type="range"
              min="5"
              max="250"
              step="5"
              value="35"
              class="mt-2.5 h-2 w-full cursor-pointer appearance-none rounded-lg bg-slate-800 accent-indigo-400"
            />
            <div class="mt-1 flex justify-between text-[11px] text-slate-500">
              <span>5 users</span>
              <span>125 users</span>
              <span>250 users</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Live Calculated Output Card -->
      <div class="lg:col-span-5">
        <div class="rounded-3xl border border-emerald-500/35 bg-gradient-to-b from-slate-900 to-slate-950 p-6 sm:p-8 shadow-2xl shadow-emerald-950/30">
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-400">
            Estimated Annual Impact (12 Months)
          </div>

          <div class="mt-3 flex items-baseline gap-2">
            <span id="roi-total-savings" class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">
              RM 248,400
            </span>
            <span class="text-xs font-semibold text-slate-400">/ year saved</span>
          </div>
          <p class="mt-1 text-xs text-slate-400">
            Combined operational labor savings + eliminated per-seat ERP license fees
          </p>

          <div class="mt-6 grid grid-cols-2 gap-3.5 border-y border-slate-800 py-5">
            <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-3.5">
              <div class="text-[11px] text-slate-400">Staff Hours Reclaimed</div>
              <div id="roi-hours-saved" class="mt-1 text-xl font-extrabold text-sky-400">3,420 hrs/yr</div>
              <div class="text-[10px] text-slate-500">Via 99.4% OCR &amp; 3-Way Match</div>
            </div>

            <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-3.5">
              <div class="text-[11px] text-slate-400">ERP License Savings</div>
              <div id="roi-license-saved" class="mt-1 text-xl font-extrabold text-indigo-400">RM 126,000/yr</div>
              <div class="text-[10px] text-slate-500">vs Tier-1 Per-Seat ERP</div>
            </div>

            <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-3.5">
              <div class="text-[11px] text-slate-400">Manual Error Reduction</div>
              <div class="mt-1 text-xl font-extrabold text-emerald-400">88.5%</div>
              <div class="text-[10px] text-slate-500">Deterministic Math Guardrails</div>
            </div>

            <div class="rounded-xl border border-slate-800 bg-slate-950/80 p-3.5">
              <div class="text-[11px] text-slate-400">Est. Payback Window</div>
              <div class="mt-1 text-xl font-extrabold text-white">2.4 Months</div>
              <div class="text-[10px] text-slate-500">Full Production Rollout</div>
            </div>
          </div>

          <div class="mt-6">
            <a
              href="#contact"
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-500 to-sky-500 px-5 py-3.5 text-sm font-bold text-slate-950 shadow-lg transition hover:brightness-110"
            >
              <span>Lock In Your Custom ROI Assessment</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let currency: 'MYR' | 'USD' = 'MYR';

  const sliderDocs = document.getElementById('slider-docs') as HTMLInputElement | null;
  const sliderStaff = document.getElementById('slider-staff') as HTMLInputElement | null;
  const sliderUsers = document.getElementById('slider-users') as HTMLInputElement | null;

  const labelDocs = document.getElementById('label-docs');
  const labelStaff = document.getElementById('label-staff');
  const labelUsers = document.getElementById('label-users');

  const roiTotalSavings = document.getElementById('roi-total-savings');
  const roiHoursSaved = document.getElementById('roi-hours-saved');
  const roiLicenseSaved = document.getElementById('roi-license-saved');

  const btnMyr = document.getElementById('roi-curr-myr');
  const btnUsd = document.getElementById('roi-curr-usd');

  function updateRoi() {
    const docs = Number(sliderDocs?.value || 2500);
    const staff = Number(sliderStaff?.value || 6);
    const users = Number(sliderUsers?.value || 35);
    const lang = (window as any).__jobshoreGetLang ? (window as any).__jobshoreGetLang() : 'en';

    const docsUnit = lang === 'bm' ? 'dok / bln' : lang === 'zh' ? '份 / 月' : 'docs / mo';
    const staffUnit = lang === 'bm' ? 'staf' : lang === 'zh' ? '名员工' : 'staff';
    const usersUnit = lang === 'bm' ? 'pengguna' : lang === 'zh' ? '名用户' : 'users';
    const hrsUnit = lang === 'bm' ? 'jam/thn' : lang === 'zh' ? '小时/年' : 'hrs/yr';
    const yrUnit = lang === 'bm' ? '/thn' : lang === 'zh' ? '/年' : '/yr';

    if (labelDocs) labelDocs.textContent = `${docs.toLocaleString()} ${docsUnit}`;
    if (labelStaff) labelStaff.textContent = `${staff} ${staffUnit}`;
    if (labelUsers) labelUsers.textContent = `${users} ${usersUnit}`;

    // Each manual document takes ~4.5 mins (0.075 hrs); AI OCR + 3-way match saves 85% of that
    const docHoursPerYear = Math.round(docs * 12 * 0.064);
    const workflowHoursPerYear = staff * 240; // ~20 hrs/mo per staff saved on status chasing/reconciliation
    const totalHoursSaved = docHoursPerYear + workflowHoursPerYear;

    // Hourly blended cost: RM 36/hr or USD $18/hr (regional/global B2B blended)
    const hourlyRate = currency === 'MYR' ? 36 : 18;
    // Per-user ERP license saved per year: RM 3,600/yr or USD $960/yr
    const seatCostPerYear = currency === 'MYR' ? 3600 : 960;

    const licenseSaved = users * seatCostPerYear;
    const opsSaved = totalHoursSaved * hourlyRate;
    const totalSaved = licenseSaved + opsSaved;

    const prefix = currency === 'MYR' ? 'RM ' : '$';

    if (roiHoursSaved) roiHoursSaved.textContent = `${totalHoursSaved.toLocaleString()} ${hrsUnit}`;
    if (roiLicenseSaved) roiLicenseSaved.textContent = `${prefix}${licenseSaved.toLocaleString()}${yrUnit}`;
    if (roiTotalSavings) roiTotalSavings.textContent = `${prefix}${totalSaved.toLocaleString()}`;
  }

  window.addEventListener('jobshore:langchange', updateRoi);

  btnMyr?.addEventListener('click', () => {
    currency = 'MYR';
    btnMyr.className = 'rounded-lg bg-sky-500 px-3 py-1 text-xs font-bold text-slate-950 transition cursor-pointer';
    if (btnUsd) {
      btnUsd.className = 'rounded-lg px-3 py-1 text-xs font-semibold text-slate-300 transition hover:text-white cursor-pointer';
    }
    updateRoi();
  });

  btnUsd?.addEventListener('click', () => {
    currency = 'USD';
    btnUsd.className = 'rounded-lg bg-sky-500 px-3 py-1 text-xs font-bold text-slate-950 transition cursor-pointer';
    if (btnMyr) {
      btnMyr.className = 'rounded-lg px-3 py-1 text-xs font-semibold text-slate-300 transition hover:text-white cursor-pointer';
    }
    updateRoi();
  });

  sliderDocs?.addEventListener('input', updateRoi);
  sliderStaff?.addEventListener('input', updateRoi);
  sliderUsers?.addEventListener('input', updateRoi);

  updateRoi();
</script>
