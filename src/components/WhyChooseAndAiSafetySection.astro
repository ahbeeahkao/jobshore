---
import { AI_SERVICE_CATALOG, AI_RISK_SAFEGUARDS, WHY_CHOOSE_US_REASONS } from '../data/insightsData';
---

<section
  id="why-choose-us"
  class="scroll-mt-20 border-t border-slate-800/80 bg-slate-950/70 py-20 sm:py-24"
  aria-labelledby="why-choose-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-20">
    <!-- PART 1: COMPLETE 8-SERVICE AI CATALOG (OUTCOME-FOCUSED) -->
    <div>
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-sky-300">
          Complete Enterprise AI Outcome Portfolio
        </span>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          8 High-ROI AI Capabilities Engineered for Measurable Outcomes
        </h2>
        <p class="mt-3 text-base text-slate-400">
          Anyone can prompt an LLM to generate raw code. Companies hire Jobshore because we wrap AI in
          <strong class="text-white">deterministic math checks, automated verification gates, and auditable monthly ROI scorecards</strong>.
        </p>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {AI_SERVICE_CATALOG.map((service) => (
          <div class="flex flex-col justify-between rounded-2xl border border-slate-800/90 bg-slate-900/60 p-5 transition hover:border-sky-500/40">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="rounded bg-sky-500/15 px-2 py-0.5 font-mono text-[11px] font-bold text-sky-400">
                  {service.code}
                </span>
                <span class="text-[10px] font-medium text-slate-400">{service.targetBuyer}</span>
              </div>
              <h3 class="mt-3 text-sm font-bold text-white leading-snug">{service.name}</h3>
              <p class="mt-2 text-xs leading-relaxed text-slate-400">{service.summary}</p>
            </div>
            <div class="mt-4 border-t border-slate-800/80 pt-3 text-[11px] font-medium text-emerald-300">
              Outcome Model: {service.pricingModel}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- PART 1.5: HOW WE TURN INTANGIBLE EXPERTISE INTO TANGIBLE, TRACKED MONTHLY OUTCOMES -->
    <div class="rounded-3xl border border-sky-500/30 bg-gradient-to-br from-slate-900 via-slate-900/95 to-sky-950/30 p-6 sm:p-10 shadow-2xl">
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-300">
          Making Intangible Value 100% Tangible &amp; Auditable
        </span>
        <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
          How We Prove Your ROI Every Month (Without Charging Per-User Seat Fees)
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-300">
          Software engineering and AI architecture often feel "intangible" until something breaks. We turn our expertise into
          <strong class="text-white">hard, physical numbers on your P&amp;L</strong> through a 4-step telemetry loop:
        </p>
      </div>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-extrabold text-sky-400">STEP 01</span>
            <span class="rounded bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-300">Day-0 Benchmark</span>
          </div>
          <h3 class="mt-3 text-sm font-bold text-white">Baseline Cost &amp; Time Audit</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-400">
            Before deploying a single line of code, we benchmark your current manual processing minutes per invoice, clerk overtime hours, POS/ERP license costs, and error rates.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-extrabold text-emerald-400">STEP 02</span>
            <span class="rounded bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-300">Built-In Telemetry</span>
          </div>
          <h3 class="mt-3 text-sm font-bold text-white">Every Action Logs Value Saved</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-400">
            Every OCR document verified, 3-way PO matched, LHDN e-Invoice validated, or regression bug blocked automatically increments your live <code class="text-sky-300">Outcome_Ledger</code> counter.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-extrabold text-amber-400">STEP 03</span>
            <span class="rounded bg-slate-800 px-2 py-0.5 text-[10px] font-semibold text-slate-300">1st of Every Month</span>
          </div>
          <h3 class="mt-3 text-sm font-bold text-white">Monthly Executive ROI Scorecard</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-400">
            On the 1st of every month, your CFO &amp; COO receive an automated 1-page scorecard showing exact <strong class="text-white">Staff Hours Reclaimed, RM/USD Saved, and 99.4%+ Accuracy Proof</strong>.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-5">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-extrabold text-violet-400">STEP 04</span>
            <span class="rounded bg-emerald-500/15 px-2 py-0.5 text-[10px] font-semibold text-emerald-300">$0 Per-Seat Tax</span>
          </div>
          <h3 class="mt-3 text-sm font-bold text-white">Outcome-Aligned Managed SLA</h3>
          <p class="mt-2 text-xs leading-relaxed text-slate-400">
            You never pay punitive per-user seat fees. You pay a fixed milestone for setup + a predictable monthly Outcome SLA tied to uptime, regulatory updates, and verified throughput.
          </p>
        </div>
      </div>
    </div>

    <!-- PART 2: WHY CHOOSE JOBSHORE (6 REASONS) -->
    <div>
      <div class="mx-auto max-w-3xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-300">
          Why Leading Teams Choose Jobshore
        </span>
        <h2 id="why-choose-heading" class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
          6 Reasons Enterprises Trust Jobshore Over Generic Agencies &amp; DIY AI
        </h2>
        <p class="mt-3 text-base text-slate-400">
          We combine open-source cost freedom with deterministic engineering discipline—so your AI, ERPNext, and POS
          systems deliver guaranteed outcomes in the real world.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {WHY_CHOOSE_US_REASONS.map((reason) => (
          <div class="rounded-2xl border border-slate-800/90 bg-slate-900/50 p-6 transition hover:border-emerald-500/40">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-500/15 font-mono text-xs font-extrabold text-emerald-400 ring-1 ring-emerald-500/30">
              {reason.number}
            </span>
            <h3 class="mt-4 text-base font-bold text-white">{reason.title}</h3>
            <p class="mt-2 text-xs sm:text-sm leading-relaxed text-slate-400">{reason.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- PART 3: AI RISK & HALLUCINATION MITIGATION MATRIX -->
    <div id="ai-safety" class="scroll-mt-24 rounded-3xl border border-rose-500/25 bg-gradient-to-b from-slate-900/90 to-slate-950 p-6 sm:p-10 shadow-2xl">
      <div class="max-w-3xl space-y-3">
        <span class="inline-flex items-center gap-2 rounded-full border border-rose-500/30 bg-rose-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-rose-300">
          Zero-Hallucination &amp; Enterprise AI Safety Architecture
        </span>
        <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
          How Jobshore Eliminates AI Hallucinations, Data Leaks &amp; Ledger Risks
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Raw Large Language Models guess probabilities—which is unacceptable for accounting ledgers, tax compliance,
          or production code. Here is how our <strong class="text-white">Deterministic Verification Architecture</strong> neutralizes the 5 biggest enterprise AI risks:
        </p>
      </div>

      <!-- Semantic Risk vs. Safeguard Table / Cards -->
      <div class="mt-8 space-y-4">
        {AI_RISK_SAFEGUARDS.map((item) => (
          <div class="grid gap-4 rounded-2xl border border-slate-800 bg-slate-950/80 p-5 lg:grid-cols-12 lg:items-center">
            <!-- Left: The Risk -->
            <div class="lg:col-span-5 space-y-1.5 border-b border-slate-800/80 pb-3 lg:border-b-0 lg:border-r lg:pb-0 lg:pr-5">
              <div class="flex items-center gap-2">
                <span class="rounded bg-rose-500/15 px-2 py-0.5 font-mono text-[10px] font-bold text-rose-400">
                  ENTERPRISE RISK
                </span>
              </div>
              <h3 class="text-sm font-bold text-white">{item.riskTitle}</h3>
              <p class="text-xs text-slate-400 leading-relaxed">{item.riskDesc}</p>
            </div>

            <!-- Right: Jobshore Safeguard -->
            <div class="lg:col-span-7 space-y-1.5 lg:pl-2">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">
                  ✓ Jobshore Safeguard: {item.jobshoreSafeguard}
                </span>
                <span class="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-emerald-300">
                  {item.badge}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">{item.safeguardDesc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- 1(B): 2026 AGENTIC AI, MODEL CONTEXT PROTOCOL (MCP) & 100% PDPA-SAFE PRIVATE LOCAL LLM CALLOUT -->
      <div class="mt-8 rounded-2xl border border-sky-500/35 bg-gradient-to-r from-sky-950/35 via-slate-950 to-emerald-950/30 p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-sky-300">
            <span>🛡️</span>
            <span>2026 Architecture: 100% PDPA-Safe Private AI &amp; Model Context Protocol (MCP) Agents</span>
          </span>
          <span class="rounded-full border border-emerald-500/35 bg-emerald-500/15 px-3 py-0.5 font-mono text-[10px] font-bold text-emerald-300">
            Zero Public Model Training • Malaysia PDPA Compliant
          </span>
        </div>
        <p class="mt-2.5 text-xs sm:text-sm text-slate-300 leading-relaxed">
          Worried about uploading confidential supplier pricing, general ledgers, or payroll records to public AI clouds? Jobshore engineers <strong class="text-white">strictly isolated enterprise AI pipelines</strong> across three layers:
        </p>
        <div class="mt-4 grid gap-3 sm:grid-cols-3 text-xs">
          <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-3.5">
            <div class="font-bold text-sky-300">1. Permission-Scoped MCP Connectors</div>
            <p class="mt-1 text-slate-400 leading-relaxed">
              Our AI agents connect to Frappe ERPNext, SQL, and POS exclusively through audited <strong class="text-slate-200">Model Context Protocol (MCP)</strong> tool servers—never raw database write access.
            </p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-3.5">
            <div class="font-bold text-emerald-300">2. Private VPC or Local GPU LLMs</div>
            <p class="mt-1 text-slate-400 leading-relaxed">
              Deploy open-weights Vision &amp; Reasoning models (<code class="text-emerald-300">Qwen2.5-VL</code>, <code class="text-emerald-300">Llama-3.3</code>, <code class="text-emerald-300">vLLM</code>) inside your Malaysian VPC or on-premise server so zero data leaves your network.
            </p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-3.5">
            <div class="font-bold text-amber-300">3. Immutable Audit &amp; Rollback Log</div>
            <p class="mt-1 text-slate-400 leading-relaxed">
              Every OCR extraction, 3-way PO match, and LHDN e-Invoice payload records a cryptographic hash, math proof, and 1-click human approval trail.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- PART 4 — 1(A): INTERACTIVE 60-SECOND AI, ERPNEXT & LHDN READINESS SCORECARD (MINI-GRADER) -->
    <div
      id="ai-readiness-grader"
      class="scroll-mt-24 rounded-3xl border border-emerald-500/35 bg-gradient-to-br from-slate-900 via-slate-950 to-emerald-950/25 p-6 sm:p-10 shadow-2xl"
    >
      <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
        <!-- Left 7 Cols: 4 Interactive Diagnostic Questions -->
        <div class="lg:col-span-7 space-y-5">
          <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-300">
              ⚡ 60-Second Interactive Diagnostic Grader
            </span>
            <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
              Check Your AI Automation, ERPNext &amp; LHDN Readiness Score
            </h2>
            <p class="mt-2 text-xs sm:text-sm text-slate-300 leading-relaxed">
              Select your current operational profile across the 4 questions below to generate an instant <strong class="text-white">0–100 Automation Opportunity Score</strong>, estimated hours reclaimed, and your tailored <strong class="text-emerald-300">3-Step Rollout Blueprint</strong>:
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <!-- Q1 -->
            <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-4">
              <label for="grader-erp" class="block text-xs font-bold uppercase tracking-wider text-sky-300">
                1. Current Accounting / ERP Setup
              </label>
              <select
                id="grader-erp"
                class="grader-input mt-2 w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-semibold text-white focus:border-sky-500 focus:outline-none"
              >
                <option value="desktop">AutoCount / SQL / UBS / Spreadsheets</option>
                <option value="cloud">Xero / QuickBooks / Bukku Cloud SaaS</option>
                <option value="tier1">SAP B1 / Oracle NetSuite / Dynamics (High Seat Fees)</option>
              </select>
            </div>

            <!-- Q2 -->
            <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-4">
              <label for="grader-volume" class="block text-xs font-bold uppercase tracking-wider text-emerald-300">
                2. Monthly Supplier Invoices / DOs / Bills
              </label>
              <select
                id="grader-volume"
                class="grader-input mt-2 w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-semibold text-white focus:border-emerald-500 focus:outline-none"
              >
                <option value="med" selected>300 – 1,500 Documents / Month</option>
                <option value="high">1,500+ Documents / Multi-Branch</option>
                <option value="low">Under 300 Documents / Month</option>
              </select>
            </div>

            <!-- Q3 -->
            <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-4">
              <label for="grader-pos" class="block text-xs font-bold uppercase tracking-wider text-amber-300">
                3. Retail / F&amp;B POS or Field Operations
              </label>
              <select
                id="grader-pos"
                class="grader-input mt-2 w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-semibold text-white focus:border-amber-500 focus:outline-none"
              >
                <option value="pos-multi" selected>Multi-Outlet Retail / F&amp;B / Pharmacy POS</option>
                <option value="b2b-fleet">B2B Warehouse / Factory / Delivery Fleet</option>
                <option value="single">Single Office / Service Business</option>
              </select>
            </div>

            <!-- Q4 -->
            <div class="rounded-2xl border border-slate-800 bg-slate-950/80 p-4">
              <label for="grader-lhdn" class="block text-xs font-bold uppercase tracking-wider text-indigo-300">
                4. Malaysia LHDN MyInvois e-Invoice Status
              </label>
              <select
                id="grader-lhdn"
                class="grader-input mt-2 w-full rounded-xl border border-slate-700 bg-slate-900 px-3 py-2 text-xs font-semibold text-white focus:border-indigo-500 focus:outline-none"
              >
                <option value="manual" selected>Manual Portal Entry / Need POS Receipt QR</option>
                <option value="partial">Batch CSV Upload (Need Real-Time ERP API)</option>
                <option value="automated">Already Live (Need AI OCR 3-Way Match &amp; Audit Defense)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Right 5 Cols: Live Calculated Scorecard & 3-Step Action Plan -->
        <div class="lg:col-span-5 rounded-2xl border border-emerald-500/40 bg-slate-950/90 p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <div>
              <div class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">
                Your Operational Readiness &amp; ROI Score
              </div>
              <div id="grader-tier-label" class="text-xs font-semibold text-slate-300 mt-0.5">
                High Immediate Automation &amp; Tax-Saving Potential
              </div>
            </div>
            <div class="text-right">
              <span id="grader-score-val" class="text-3xl font-extrabold text-emerald-400 font-mono">91</span>
              <span class="text-xs font-bold text-slate-400">/100</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-2.5 text-center">
            <div class="rounded-xl border border-slate-800 bg-slate-900/90 p-2.5">
              <div class="text-[10px] font-semibold uppercase text-slate-400">Est. Time Reclaimed</div>
              <div id="grader-hours-val" class="mt-0.5 text-sm sm:text-base font-extrabold text-sky-300">
                165 hrs / mo
              </div>
            </div>
            <div class="rounded-xl border border-slate-800 bg-slate-900/90 p-2.5">
              <div class="text-[10px] font-semibold uppercase text-slate-400">Tax Deduction Eligibility</div>
              <div id="grader-tax-val" class="mt-0.5 text-sm sm:text-base font-extrabold text-amber-300">
                Up to RM 50,000 + ACA
              </div>
            </div>
          </div>

          <div class="space-y-2 text-xs">
            <div class="font-bold uppercase tracking-wider text-slate-300 text-[11px]">
              Recommended 3-Step Jobshore Action Plan:
            </div>
            <ul id="grader-steps-list" class="space-y-1.5 text-slate-300 leading-relaxed">
              <li class="flex items-start gap-2">
                <span class="text-emerald-400 font-bold">1.</span>
                <span id="grader-step-1">Deploy Vision-LLM OCR + 3-Way PO/GRN Match to eliminate 85% of manual bill keying.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sky-400 font-bold">2.</span>
                <span id="grader-step-2">Roll out Offline-First POS with Thermal Receipt LHDN QR Self-Claim &amp; Monthly Consolidated e-Invoicing.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 font-bold">3.</span>
                <span id="grader-step-3">Unify stock &amp; accounting on Frappe ERPNext v15 ($0/seat license) and claim the RM 50,000 LHDN tax deduction.</span>
              </li>
            </ul>
          </div>

          <a
            href="#contact"
            id="apply-grader-to-quote-btn"
            class="flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-500 to-sky-500 px-4 py-3 text-xs sm:text-sm font-extrabold text-slate-950 shadow-lg transition hover:brightness-110"
          >
            <span>🚀 Apply My Readiness Plan to the 14-Day Pilot Quote Closer</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const graderErp = document.getElementById('grader-erp') as HTMLSelectElement | null;
  const graderVol = document.getElementById('grader-volume') as HTMLSelectElement | null;
  const graderPos = document.getElementById('grader-pos') as HTMLSelectElement | null;
  const graderLhdn = document.getElementById('grader-lhdn') as HTMLSelectElement | null;
  const graderScoreVal = document.getElementById('grader-score-val');
  const graderHoursVal = document.getElementById('grader-hours-val');
  const graderStep1 = document.getElementById('grader-step-1');
  const graderStep2 = document.getElementById('grader-step-2');
  const graderStep3 = document.getElementById('grader-step-3');
  const applyGraderBtn = document.getElementById('apply-grader-to-quote-btn');

  function getLang(): 'en' | 'bm' | 'zh' {
    const fn = (window as any).__jobshoreGetLang;
    return fn ? fn() : 'en';
  }

  function updateReadinessGrader() {
    const erp = graderErp?.value || 'desktop';
    const vol = graderVol?.value || 'med';
    const pos = graderPos?.value || 'pos-multi';
    const lhdn = graderLhdn?.value || 'manual';
    const lang = getLang();

    let score = 74;
    let hours = 85;

    if (erp === 'desktop') {
      score += 7;
      hours += 35;
    } else if (erp === 'tier1') {
      score += 9;
      hours += 45;
    } else {
      score += 5;
      hours += 25;
    }

    if (vol === 'high') {
      score += 8;
      hours += 95;
    } else if (vol === 'med') {
      score += 5;
      hours += 45;
    } else {
      score += 2;
      hours += 15;
    }

    if (pos === 'pos-multi' || pos === 'b2b-fleet') {
      score += 4;
      hours += 25;
    }
    if (lhdn === 'manual') {
      score += 4;
      hours += 20;
    } else if (lhdn === 'partial') {
      score += 3;
      hours += 12;
    }

    if (score > 98) score = 98;

    if (graderScoreVal) graderScoreVal.textContent = String(score);
    if (graderHoursVal) {
      graderHoursVal.textContent =
        lang === 'bm' ? `${hours} jam / bln` : lang === 'zh' ? `${hours} 小时 / 月` : `${hours} hrs / mo`;
    }

    if (graderStep1 && graderStep2 && graderStep3) {
      if (lang === 'bm') {
        graderStep1.textContent =
          vol === 'high'
            ? 'Laksanakan AI OCR Pelbagai Bahasa + Padanan 3-Hala PO/GRN untuk mengautomasikan 1,500+ bil bulanan.'
            : 'Laksanakan AI OCR Berasaskan Matematik + Padanan 3-Hala PO/GRN untuk menghapuskan 85% kemasukan bil manual.';
        graderStep2.textContent =
          pos === 'pos-multi'
            ? 'Pasang POS Luar Talian dengan Kod QR Resit LHDN & e-Invois Disatukan bulanan automatik.'
            : 'Automasi aliran pesanan B2B WhatsApp, e-POD gudang, dan penyegerakan inventori masa nyata.';
        graderStep3.textContent =
          erp === 'tier1'
            ? 'Gantikan lesen ERP mahal dengan Frappe ERPNext v15 ($0 yuran per-pengguna) & tuntut potongan cukai RM 50,000.'
            : 'Satukan perakaunan & stok pada Frappe ERPNext v15 ($0 lesen/pengguna) dan tuntut potongan cukai LHDN RM 50,000.';
      } else if (lang === 'zh') {
        graderStep1.textContent =
          vol === 'high'
            ? '部署多语言视觉 AI OCR + PO/GRN 三单匹配，全自动处理每月 1,500+ 份供应商单据。'
            : '部署确定性数学校验 AI OCR + PO/GRN 三单匹配，消除 85% 人工录单工作。';
        graderStep2.textContent =
          pos === 'pos-multi'
            ? '上线断网离线 POS 收银系统，内置小票 LHDN 二维码自助开票与月度汇总电子发票自动申报。'
            : '打通 WhatsApp B2B 自动接单机器人、移动端扫码出入库/电子签收 (e-POD) 与库存实时同步。';
        graderStep3.textContent =
          erp === 'tier1'
            ? '将高昂按人头收费的传统 ERP 迁移至 $0 授权费的 Frappe ERPNext v15，并申领 RM 50,000 LHDN 专项扣税。'
            : '在 Frappe ERPNext v15（$0 按人头授权费）统一财务与多仓进销存，并申领 RM 50,000 LHDN 电子发票扣税。';
      } else {
        graderStep1.textContent =
          vol === 'high'
            ? 'Deploy Multi-Language Vision-LLM OCR + 3-Way PO/GRN Match to automate 1,500+ monthly supplier bills.'
            : 'Deploy Vision-LLM OCR + 3-Way PO/GRN Match to eliminate 85% of manual bill keying.';
        graderStep2.textContent =
          pos === 'pos-multi'
            ? 'Roll out Offline-First POS with Thermal Receipt LHDN QR Self-Claim & Monthly Consolidated e-Invoicing.'
            : 'Automate WhatsApp B2B order intake, warehouse barcode/e-POD mobile sync, and real-time stock reservation.';
        graderStep3.textContent =
          erp === 'tier1'
            ? 'Replace high-cost per-seat ERP licenses with Frappe ERPNext v15 ($0/seat) & claim the RM 50,000 tax deduction.'
            : 'Unify stock & accounting on Frappe ERPNext v15 ($0/seat license) and claim the RM 50,000 LHDN tax deduction.';
      }
    }
  }

  document.querySelectorAll('.grader-input').forEach((el) => {
    el.addEventListener('change', updateReadinessGrader);
  });
  window.addEventListener('jobshore:langchange', updateReadinessGrader);

  applyGraderBtn?.addEventListener('click', () => {
    const score = graderScoreVal?.textContent || '91';
    const hours = graderHoursVal?.textContent || '165 hrs / mo';
    const pos = graderPos?.value || 'pos-multi';
    const category = pos === 'pos-multi' ? 'POS + ERPNext + AI OCR' : 'ERPNext + AI OCR + BPA Automation';
    window.dispatchEvent(
      new CustomEvent('jobshore:select-portfolio-project', {
        detail: {
          project: `AI & LHDN Readiness Scorecard (${score}/100 — Est. ${hours} Saved)`,
          client: '60-Second Diagnostic Plan',
          category,
        },
      })
    );
  });
</script>
