---
import { CASE_STUDIES } from '../data/siteData';
---

<section class="py-20 sm:py-24" aria-labelledby="case-studies-heading">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-sky-300">
        Verified Production Outcomes
      </span>
      <h2 id="case-studies-heading" class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Real-World Impact Across Manufacturing, FinTech &amp; Distribution
      </h2>
      <p class="mt-3 text-base text-slate-400">
        See how mid-market and enterprise teams in Malaysia, Singapore, and beyond deploy Jobshore’s AI OCR,
        verification pipelines, Frappe ERPNext, and mobile applications.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {CASE_STUDIES.map((cs) => (
        <article class="flex flex-col justify-between rounded-2xl border border-slate-800/90 bg-slate-900/50 p-6 transition hover:border-sky-500/40">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="rounded-full border border-sky-500/30 bg-sky-500/10 px-2.5 py-0.5 text-[11px] font-bold text-sky-300">
                {cs.pillarBadge}
              </span>
              <span class="text-[11px] font-medium text-slate-400">{cs.region}</span>
            </div>

            <div class="mt-3 text-xs font-semibold uppercase tracking-wider text-slate-400">
              {cs.clientType}
            </div>
            <h3 class="mt-1 text-lg font-bold text-white leading-snug">{cs.title}</h3>

            <div class="mt-4 space-y-3 text-xs leading-relaxed text-slate-300">
              <div>
                <span class="font-bold text-slate-200">Challenge: </span>
                <span class="text-slate-400">{cs.challenge}</span>
              </div>
              <div>
                <span class="font-bold text-emerald-300">Jobshore Solution: </span>
                <span class="text-slate-300">{cs.solution}</span>
              </div>
            </div>
          </div>

          <div class="mt-6 space-y-4 border-t border-slate-800 pt-4">
            <dl class="grid grid-cols-3 gap-2 text-center">
              {cs.results.map((res) => (
                <div class="rounded-xl bg-slate-950/90 p-2.5 border border-slate-800/80">
                  <dd class="text-sm sm:text-base font-extrabold text-emerald-400">{res.metric}</dd>
                  <dt class="mt-0.5 text-[10px] text-slate-400 leading-tight">{res.label}</dt>
                </div>
              ))}
            </dl>

            <div class="flex flex-wrap gap-1.5">
              {cs.stack.map((tech) => (
                <span class="rounded bg-slate-950 px-2 py-0.5 font-mono text-[10px] text-slate-400 border border-slate-800">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
