---
import { CASE_STUDIES, COMPANY_INFO } from '../data/siteData';

const portfolioCategories = [
  'All Deployments',
  'Frappe ERPNext',
  'POS Systems',
  'Business Automation',
  'AI & OCR',
  'Web & Mobile Apps',
];
---

<section
  id="portfolio"
  class="scroll-mt-20 py-20 sm:py-24 border-b border-slate-800/80"
  aria-labelledby="portfolio-heading"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-sky-300">
        Production Portfolio &amp; Verified Case Studies
      </span>
      <h2
        id="portfolio-heading"
        class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
        data-i18n-en="Deployed Systems & Tracked Outcomes Across All 5 Pillars"
        data-i18n-bm="Portfolio Sistem Sebenar & Hasil Terbukti Merentasi 5 Teras"
        data-i18n-zh="覆盖 5 大核心业务支柱的真实落地案例与月度量化成果"
      >
        Deployed Systems &amp; Tracked Outcomes Across All 5 Pillars
      </h2>
      <p class="mt-3 text-base text-slate-400">
        See how manufacturers, retail/F&amp;B chains, wholesale distributors, and regional enterprises deploy Jobshore’s
        <strong class="text-white">AI OCR, Workflow Automation, Frappe ERPNext, Offline POS, and Web/Mobile Apps</strong>—and how we track their ROI every month.
      </p>

      <!-- Direct CTA to Dedicated Portfolio Subdomain (portfolio.jobshore.dpdns.org) -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href={COMPANY_INFO.portfolioPortalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-500 to-sky-500 px-5 py-2.5 text-xs sm:text-sm font-extrabold text-slate-950 shadow-lg shadow-emerald-500/20 transition hover:brightness-110"
        >
          <span>🚀 Explore Live Client &amp; Sample Projects Portal</span>
          <span class="rounded bg-slate-950/20 px-1.5 py-0.5 font-mono text-[11px]">portfolio.jobshore.dpdns.org ↗</span>
        </a>
      </div>
    </div>

    <!-- Interactive Portfolio Filter Bar -->
    <div
      class="mt-10 flex flex-wrap justify-center gap-2"
      role="group"
      aria-label="Filter Portfolio by Service Pillar"
    >
      {portfolioCategories.map((cat, idx) => (
        <button
          type="button"
          data-portfolio-filter={cat}
          class={`portfolio-filter-btn rounded-xl border px-3.5 py-2 text-xs font-semibold transition cursor-pointer ${
            idx === 0
              ? 'border-sky-500 bg-sky-500/15 text-white font-bold'
              : 'border-slate-800 bg-slate-900/70 text-slate-400 hover:border-slate-700 hover:text-white'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- 6-Card Production Portfolio Grid -->
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {CASE_STUDIES.map((cs) => (
        <article
          data-portfolio-category={cs.category}
          class="portfolio-card flex flex-col justify-between rounded-3xl border border-slate-800/90 bg-slate-900/60 p-6 transition hover:border-sky-500/40"
        >
          <div>
            <!-- Top Badge & Deployment Speed -->
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="rounded-full border border-sky-500/30 bg-sky-500/10 px-2.5 py-0.5 text-[11px] font-bold text-sky-300">
                {cs.pillarBadge}
              </span>
              <span class="rounded-md bg-emerald-500/10 border border-emerald-500/25 px-2 py-0.5 font-mono text-[10px] font-semibold text-emerald-300">
                {cs.timeline}
              </span>
            </div>

            <!-- Client Profile & Region -->
            <div class="mt-3 flex items-center justify-between gap-2 text-[11px] font-semibold uppercase tracking-wider text-slate-400">
              <span>{cs.clientType}</span>
            </div>
            <div class="text-[11px] text-slate-500">{cs.region}</div>

            <!-- Outcome Headline -->
            <h3 class="mt-2 text-lg font-extrabold text-white leading-snug">
              {cs.title}
            </h3>

            <!-- Challenge & Solution -->
            <div class="mt-4 space-y-2.5 text-xs leading-relaxed">
              <div>
                <span class="font-bold text-rose-300">Before (Bottleneck): </span>
                <span class="text-slate-400">{cs.challenge}</span>
              </div>
              <div>
                <span class="font-bold text-emerald-300">Engineered Solution: </span>
                <span class="text-slate-300">{cs.solution}</span>
              </div>
            </div>

            <!-- Physical System Delivered Box -->
            <div class="mt-4 rounded-xl border border-slate-800 bg-slate-950/80 p-3 text-xs">
              <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-sky-400">
                🖥️ Tangible System Delivered:
              </div>
              <p class="mt-1 text-slate-200 font-medium leading-relaxed">
                {cs.deliverablePreview}
              </p>
            </div>

            <!-- Monthly Scorecard Telemetry Proof -->
            <div class="mt-2.5 rounded-xl border border-emerald-500/25 bg-emerald-950/15 p-3 text-xs">
              <div class="font-mono text-[10px] font-bold uppercase tracking-wider text-emerald-400">
                📊 Ongoing Monthly Scorecard Proof:
              </div>
              <p class="mt-1 text-slate-200 leading-relaxed">
                {cs.monthlyScorecardProof}
              </p>
            </div>
          </div>

          <!-- Bottom KPIs, Tech Stack & CTA -->
          <div class="mt-6 space-y-4 border-t border-slate-800 pt-4">
            <dl class="grid grid-cols-3 gap-2 text-center">
              {cs.results.map((res) => (
                <div class="rounded-xl bg-slate-950/90 p-2.5 border border-slate-800/80">
                  <dd class="text-sm sm:text-base font-extrabold text-emerald-400">{res.metric}</dd>
                  <dt class="mt-0.5 text-[10px] text-slate-400 leading-tight">{res.label}</dt>
                </div>
              ))}
            </dl>

            <div class="flex flex-wrap gap-1.5">
              {cs.stack.map((tech) => (
                <span class="rounded bg-slate-950 px-2 py-0.5 font-mono text-[10px] text-slate-400 border border-slate-800">
                  {tech}
                </span>
              ))}
            </div>

            <div class="pt-1 flex flex-col sm:flex-row gap-2">
              <a
                href={COMPANY_INFO.portfolioPortalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl border border-emerald-500/35 bg-emerald-500/10 px-3 py-2 text-xs font-bold text-emerald-300 transition hover:bg-emerald-500/20"
              >
                <span>View Live Sample Project</span>
                <span>↗</span>
              </a>
              <a
                href="#contact"
                class="inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl border border-sky-500/30 bg-sky-500/10 px-3 py-2 text-xs font-bold text-sky-300 transition hover:bg-sky-500/20"
              >
                <span>Request Live Demo of This Architecture</span>
                <span>→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- NDA Confidentiality & Live Staging Demo Banner -->
    <div class="mt-10 rounded-2xl border border-slate-800 bg-slate-900/75 p-5 sm:p-6 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
      <div class="space-y-1 text-xs sm:text-sm">
        <div class="font-bold text-white flex items-center gap-2">
          <span class="text-emerald-400">🔒</span>
          <span>Enterprise NDA Confidentiality &amp; Live Reference Walkthroughs</span>
        </div>
        <p class="text-slate-400 text-xs leading-relaxed max-w-3xl">
          Because our systems process sensitive general ledgers, supplier pricing, and LHDN MyInvois tax filings, client company names are anonymized under strict NDA. Want to see the real software in action? We maintain <strong class="text-slate-200">live, pre-populated staging environments</strong> for every pillar above—or send us 3 sample documents to test on your own data.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <a
          href={COMPANY_INFO.portfolioPortalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-xl border border-emerald-500/40 bg-emerald-500/15 px-4 py-2.5 text-xs font-extrabold text-emerald-300 transition hover:bg-emerald-500/25"
        >
          <span>Launch Projects Portal</span>
          <span>↗</span>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-sky-500 to-emerald-500 px-4 py-2.5 text-xs font-extrabold text-slate-950 shadow-lg transition hover:brightness-110"
        >
          <span>Book 15-Min Live Staging Demo</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const portfolioBtns = document.querySelectorAll('.portfolio-filter-btn');
  const portfolioCards = document.querySelectorAll('.portfolio-card');

  portfolioBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-portfolio-filter');

      portfolioBtns.forEach((b) => {
        b.classList.remove('border-sky-500', 'bg-sky-500/15', 'text-white', 'font-bold');
        b.classList.add('border-slate-800', 'bg-slate-900/70', 'text-slate-400');
      });

      btn.classList.remove('border-slate-800', 'bg-slate-900/70', 'text-slate-400');
      btn.classList.add('border-sky-500', 'bg-sky-500/15', 'text-white', 'font-bold');

      portfolioCards.forEach((card) => {
        const cat = card.getAttribute('data-portfolio-category');
        if (selected === 'All Deployments' || cat === selected) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>
