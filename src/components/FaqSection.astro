---
import { GLOBAL_FAQS } from '../data/siteData';

const categories = [
  'All',
  'AI & OCR',
  'Frappe & ERPNext',
  'POS Software & Systems',
  'Business Automation',
  'Web & Mobile',
  'SEO, AEO & Engagement',
];
---

<section id="faq" class="scroll-mt-20 py-20 sm:py-24" aria-labelledby="faq-heading">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-sky-300">
        AEO-Indexed Knowledge Base &amp; FAQPage Schema
      </span>
      <h2 id="faq-heading" class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        Frequently Asked Questions (Direct Answers)
      </h2>
      <p class="mt-3 text-base text-slate-400">
        Structured, citation-ready answers covering AI OCR, code verification, automated testing, Frappe ERPNext,
        POS software &amp; systems, Malaysia LHDN MyInvois e-Invoicing, and web/mobile development.
      </p>
    </div>

    <!-- Category Filter Buttons -->
    <div class="mt-8 flex flex-wrap justify-center gap-2" role="group" aria-label="Filter FAQs by Category">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-faq-filter={cat}
          class={`faq-filter-btn rounded-xl border px-3.5 py-1.5 text-xs font-semibold transition cursor-pointer ${
            idx === 0
              ? 'border-sky-500 bg-sky-500/15 text-white font-bold'
              : 'border-slate-800 bg-slate-900/70 text-slate-400 hover:border-slate-700 hover:text-white'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Semantic Details / Summary Accordion -->
    <div class="mt-8 space-y-3.5">
      {GLOBAL_FAQS.map((item, idx) => (
        <details
          data-faq-category={item.category}
          open={idx < 3}
          class="faq-item group rounded-2xl border border-slate-800/90 bg-slate-900/60 p-5 transition hover:border-sky-500/30 open:border-sky-500/40 open:bg-slate-900/90"
        >
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left">
            <div>
              <span class="mb-1 inline-block rounded bg-slate-800 px-2 py-0.5 font-mono text-[10px] font-semibold text-sky-400">
                {item.category}
              </span>
              <h3 class="text-sm sm:text-base font-bold text-white group-open:text-sky-300">
                {item.question}
              </h3>
            </div>
            <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg border border-slate-700 bg-slate-800 text-xs font-bold text-slate-300 transition group-open:rotate-45 group-open:border-sky-500/50 group-open:text-sky-300">
              +
            </span>
          </summary>
          <div class="mt-3 border-t border-slate-800/80 pt-3 text-sm leading-relaxed text-slate-300">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.faq-filter-btn');
  const faqItems = document.querySelectorAll('.faq-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-faq-filter');

      filterBtns.forEach((b) => {
        b.classList.remove('border-sky-500', 'bg-sky-500/15', 'text-white', 'font-bold');
        b.classList.add('border-slate-800', 'bg-slate-900/70', 'text-slate-400');
      });

      btn.classList.remove('border-slate-800', 'bg-slate-900/70', 'text-slate-400');
      btn.classList.add('border-sky-500', 'bg-sky-500/15', 'text-white', 'font-bold');

      faqItems.forEach((item) => {
        const cat = item.getAttribute('data-faq-category');
        if (selected === 'All' || cat === selected) {
          item.classList.remove('hidden');
        } else {
          item.classList.add('hidden');
        }
      });
    });
  });
</script>
