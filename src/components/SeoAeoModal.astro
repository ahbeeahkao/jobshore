---
import { buildHomeJsonLd } from '../data/siteData';
import { withBase } from '../utils/paths';

interface Props {
  jsonLd?: Record<string, unknown>;
}

const { jsonLd = buildHomeJsonLd() } = Astro.props;
const formattedSchema = JSON.stringify(jsonLd, null, 2);
---

<div
  id="seo-aeo-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
  aria-labelledby="seo-aeo-modal-title"
>
  <div class="relative flex max-h-[88vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-sky-500/30 bg-slate-900 shadow-2xl shadow-sky-950/60">
    <!-- Modal Header -->
    <div class="flex items-center justify-between border-b border-slate-800 bg-slate-950/70 px-6 py-4">
      <div class="flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-500/15 text-emerald-400 ring-1 ring-emerald-500/30">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </span>
        <div>
          <h2 id="seo-aeo-modal-title" class="text-base font-bold text-white sm:text-lg">
            Live SEO &amp; AEO (Answer Engine Optimization) Inspector
          </h2>
          <p class="text-xs text-slate-400">
            Verify how Google, Bing, ChatGPT Search, Perplexity, Claude &amp; Gemini index and cite this page
          </p>
        </div>
      </div>
      <button
        type="button"
        id="close-seo-modal-btn"
        class="rounded-lg border border-slate-700 bg-slate-800/80 p-2 text-slate-300 transition hover:border-slate-600 hover:text-white cursor-pointer"
        aria-label="Close SEO & AEO Inspector"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="code-scroll overflow-y-auto p-6 space-y-6">
      <!-- Score & Machine-Readable Endpoints -->
      <div class="grid gap-4 sm:grid-cols-4">
        <div class="rounded-xl border border-emerald-500/25 bg-emerald-950/20 p-3.5">
          <div class="text-xs font-medium text-emerald-300">Technical SEO Score</div>
          <div class="mt-1 text-2xl font-extrabold text-white">100 / 100</div>
          <div class="mt-1 text-[11px] text-slate-400">Static Astro HTML, Canonical, Hreflang &amp; Geo Meta</div>
        </div>
        <div class="rounded-xl border border-sky-500/25 bg-sky-950/20 p-3.5">
          <div class="text-xs font-medium text-sky-300">AEO Citation Readiness</div>
          <div class="mt-1 text-2xl font-extrabold text-white">A+ Tier</div>
          <div class="mt-1 text-[11px] text-slate-400">Speakable, Direct Answer Capsules &amp; Semantic Tables</div>
        </div>
        <div class="rounded-xl border border-indigo-500/25 bg-indigo-950/20 p-3.5">
          <div class="text-xs font-medium text-indigo-300">Schema.org Graph</div>
          <div class="mt-1 text-2xl font-extrabold text-white">8 Entities</div>
          <div class="mt-1 text-[11px] text-slate-400">Org, ITService, 5 Service Pillars, Speakable, FAQ</div>
        </div>
        <div class="rounded-xl border border-violet-500/25 bg-violet-950/20 p-3.5">
          <div class="text-xs font-medium text-violet-300">GitHub Pages + Custom URL</div>
          <div class="mt-1 text-2xl font-extrabold text-white">Ready</div>
          <div class="mt-1 text-[11px] text-slate-400">Subpath &amp; Custom Domain Auto-Configurable</div>
        </div>
      </div>

      <!-- Direct Crawl Links -->
      <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">
          Live Machine-Readable SEO &amp; AEO Endpoints (Click to Open Raw File)
        </div>
        <div class="mt-3 flex flex-wrap gap-2.5">
          <a
            href={withBase('/llms.txt')}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg border border-sky-500/30 bg-sky-500/10 px-3.5 py-2 text-xs font-semibold text-sky-300 transition hover:bg-sky-500/20"
          >
            <span>/llms.txt</span>
            <span class="rounded bg-sky-500/20 px-1.5 py-0.5 text-[10px]">LLM Summary</span>
          </a>
          <a
            href={withBase('/llms-full.txt')}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-2 text-xs font-semibold text-emerald-300 transition hover:bg-emerald-500/20"
          >
            <span>/llms-full.txt</span>
            <span class="rounded bg-emerald-500/20 px-1.5 py-0.5 text-[10px]">Full AEO Knowledge Base</span>
          </a>
          <a
            href={withBase('/robots.txt')}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg border border-indigo-500/30 bg-indigo-500/10 px-3.5 py-2 text-xs font-semibold text-indigo-300 transition hover:bg-indigo-500/20"
          >
            <span>/robots.txt</span>
            <span class="rounded bg-indigo-500/20 px-1.5 py-0.5 text-[10px]">AI Bot Policy</span>
          </a>
          <a
            href={withBase('/sitemap.xml')}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg border border-violet-500/30 bg-violet-500/10 px-3.5 py-2 text-xs font-semibold text-violet-300 transition hover:bg-violet-500/20"
          >
            <span>/sitemap.xml</span>
            <span class="rounded bg-violet-500/20 px-1.5 py-0.5 text-[10px]">XML Sitemap</span>
          </a>
        </div>
      </div>

      <!-- Active JSON-LD Graph Preview -->
      <div>
        <div class="mb-2 flex items-center justify-between">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-300">
            Embedded JSON-LD <code class="text-sky-400">@graph</code> Schema (Injected in <code class="text-sky-400">&lt;head&gt;</code>)
          </span>
          <button
            type="button"
            id="copy-jsonld-btn"
            class="rounded-md border border-slate-700 bg-slate-800 px-3 py-1 text-xs font-medium text-slate-200 transition hover:border-sky-500/50 hover:text-sky-300 cursor-pointer"
          >
            Copy JSON-LD
          </button>
        </div>
        <pre
          id="jsonld-code-block"
          class="code-scroll max-h-72 overflow-auto rounded-xl border border-slate-800 bg-slate-950 p-4 font-mono text-xs leading-relaxed text-sky-200"
        >{formattedSchema}</pre>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('seo-aeo-modal');
  const closeBtn = document.getElementById('close-seo-modal-btn');
  const copyBtn = document.getElementById('copy-jsonld-btn');
  const codeBlock = document.getElementById('jsonld-code-block');

  document.querySelectorAll('[data-open-seo-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      }
    });
  });

  closeBtn?.addEventListener('click', () => {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });

  copyBtn?.addEventListener('click', async () => {
    if (codeBlock && copyBtn) {
      await navigator.clipboard.writeText(codeBlock.textContent || '');
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Copied to Clipboard!';
      setTimeout(() => {
        copyBtn.textContent = original;
      }, 2000);
    }
  });
</script>
