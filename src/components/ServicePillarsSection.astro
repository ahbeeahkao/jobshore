---
import { COMPANY_INFO, SERVICE_PILLARS } from '../data/siteData';
import { withBase } from '../utils/paths';

const badgeStyles: Record<string, string> = {
  sky: 'border-sky-500/30 bg-sky-500/10 text-sky-300',
  emerald: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-300',
  indigo: 'border-indigo-500/30 bg-indigo-500/10 text-indigo-300',
  amber: 'border-amber-500/30 bg-amber-500/10 text-amber-300',
  violet: 'border-violet-500/30 bg-violet-500/10 text-violet-300',
};

const cardBorderStyles: Record<string, string> = {
  sky: 'hover:border-sky-500/50',
  emerald: 'hover:border-emerald-500/50',
  indigo: 'hover:border-indigo-500/50',
  amber: 'hover:border-amber-500/50',
  violet: 'hover:border-violet-500/50',
};
---

<section id="services" class="py-20 sm:py-24 border-b border-slate-800/80">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-sky-400">
        Five Outcome-Driven Engineering Pillars
      </p>
      <h2
        id="i18n-pillars-heading"
        class="mt-2 text-3xl font-extrabold tracking-tight text-white sm:text-4xl"
        data-i18n-en="We Don’t Just Sell Code or Per-Seat Licenses. We Deliver 5 Tracked Business Outcomes."
        data-i18n-bm="Kami Tidak Sekadar Menjual Kod atau Lesen Pengguna. Kami Membekalkan 5 Hasil Perniagaan Terjamin."
        data-i18n-zh="我们不卖凑字数的代码，也不收按人头计费的软件税——我们交付 5 大可量化的商业结果"
      >
        We Don’t Just Sell Code or Per-Seat Licenses. We Deliver 5 Tracked Business Outcomes.
      </h2>
      <p
        id="i18n-pillars-subheading"
        class="mt-4 text-base text-slate-400"
      >
        When anyone can prompt an LLM to generate raw code, writing code is no longer the bottleneck—<strong class="text-white">verified accuracy, zero-downtime reliability, and measurable ROI</strong> are. Every Jobshore pillar includes a <strong class="text-emerald-300">Tangible Monthly Outcome Scorecard</strong> so leadership sees the exact hours, Ringgit/Dollars, and errors saved every single month.
      </p>
    </div>

    <!-- Pillars Stack -->
    <div class="mt-16 space-y-12">
      {SERVICE_PILLARS.map((pillar) => (
        <article
          id={pillar.id}
          class={`scroll-mt-24 rounded-3xl border border-slate-800 bg-slate-900/60 p-6 sm:p-8 lg:p-10 transition ${cardBorderStyles[pillar.accentColor]}`}
        >
          <!-- Top Guaranteed Outcome Promise Banner -->
          <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-emerald-500/30 bg-emerald-950/25 px-4 py-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/20 text-xs font-bold text-emerald-300">
                ✓
              </span>
              <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-400">
                Guaranteed Outcome:
              </span>
              <span class="text-xs sm:text-sm font-bold text-white">
                {pillar.outcomePromise}
              </span>
            </div>
            <span class="rounded-lg border border-slate-700 bg-slate-900/90 px-2.5 py-1 font-mono text-[11px] text-sky-300">
              {pillar.commercialModel}
            </span>
          </div>

          <div class="grid gap-8 lg:grid-cols-12">
            <!-- Pillar Overview & Tangible Scorecard (5 cols) -->
            <div class="lg:col-span-5 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class={`inline-flex items-center rounded-full border px-3 py-1 text-xs font-bold ${badgeStyles[pillar.accentColor]}`}>
                    {pillar.badge}
                  </span>
                </div>

                <h3 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
                  <a
                    href={withBase(`/services/${pillar.slug}`)}
                    class="hover:text-sky-400 transition"
                    data-i18n-en={pillar.title}
                    data-i18n-bm={pillar.titleBm}
                    data-i18n-zh={pillar.titleZh}
                  >
                    {pillar.title}
                  </a>
                </h3>

                <p
                  class="text-sm font-medium text-slate-300 leading-relaxed"
                  data-i18n-en={pillar.subtitle}
                  data-i18n-bm={pillar.subtitleBm}
                  data-i18n-zh={pillar.subtitleZh}
                >
                  {pillar.subtitle}
                </p>

                <!-- Tangible Monthly Outcome Scorecard (Making Intangible Value Tangible) -->
                <div class="rounded-2xl border border-sky-500/30 bg-sky-950/20 p-4">
                  <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-sky-300">
                      📊 Tangible Monthly Scorecard (How We Prove ROI)
                    </span>
                    <span class="font-mono text-[10px] font-semibold text-emerald-400">Auditable SLA</span>
                  </div>
                  <p class="mt-2 text-xs leading-relaxed text-slate-200">
                    {pillar.tangibleScorecard}
                  </p>
                  <ul class="mt-3 space-y-1.5 border-t border-slate-800/80 pt-2.5 text-xs text-slate-300">
                    {pillar.deliverables.slice(0, 3).map((deliv) => (
                      <li class="flex items-start gap-2">
                        <span class="mt-0.5 font-bold text-emerald-400">▸</span>
                        <span>{deliv}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Fast-Start Wedge Offer (Low-Hanging Carrot to Close Deals Fast) -->
                <div class="rounded-2xl border border-amber-500/35 bg-amber-950/20 p-4">
                  <div class="flex items-center justify-between gap-2">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-amber-300">
                      ⚡ Fast-Start Pilot / Low-Risk Entry Offer
                    </span>
                    <span class="rounded bg-amber-500/20 px-2 py-0.5 font-mono text-[10px] font-semibold text-amber-200">
                      100% Credited to Rollout
                    </span>
                  </div>
                  <p class="mt-1.5 text-xs leading-relaxed text-slate-200">
                    {pillar.fastStartCarrot}
                  </p>
                </div>

                <!-- AEO Direct Answer Block per Service Pillar -->
                <div class="aeo-summary rounded-2xl border border-slate-800 bg-slate-950/90 p-4 text-xs leading-relaxed text-slate-300">
                  <div class="mb-1 font-mono text-[10px] font-bold uppercase tracking-wider text-sky-400">
                    Executive Summary (SEO &amp; AEO Citation Capsule)
                  </div>
                  <p>{pillar.aeoSummary}</p>
                </div>
              </div>

              <!-- Key Metrics & Tech Tags -->
              <div class="space-y-4 pt-2">
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                  {pillar.kpis.map((m) => (
                    <div class="rounded-xl border border-slate-800/90 bg-slate-950/60 p-3 text-center">
                      <div class="text-base sm:text-lg font-extrabold text-white">{m.value}</div>
                      <div class="mt-0.5 text-[10px] text-slate-400">{m.label}</div>
                    </div>
                  ))}
                </div>

                <div class="flex flex-wrap gap-1.5">
                  {pillar.techStack.slice(0, 7).map((kw) => (
                    <span class="rounded-md bg-slate-800/90 px-2.5 py-1 font-mono text-[11px] text-slate-300">
                      {kw}
                    </span>
                  ))}
                </div>

                <div class="pt-1 flex flex-wrap items-center justify-between gap-3 border-t border-slate-800/80">
                  <a
                    href={withBase(`/services/${pillar.slug}`)}
                    class="inline-flex items-center gap-1.5 text-xs font-bold text-sky-400 hover:text-sky-300"
                  >
                    <span>Explore {pillar.shortTitle} Deep-Dive</span>
                    <span>→</span>
                  </a>
                  <a
                    href="#contact"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 px-3 py-1.5 text-xs font-bold text-emerald-300 hover:bg-emerald-500/20"
                  >
                    <span>{COMPANY_INFO.showStartingPrice ? pillar.startingInvestment : 'Scope Your 14-Day Pilot →'}</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Sub-Services Outcome Grid (7 cols) -->
            <div class="lg:col-span-7 grid gap-4 sm:grid-cols-2">
              {pillar.subServices.map((sub) => (
                <div class="flex flex-col justify-between rounded-2xl border border-slate-800/90 bg-slate-950/70 p-5 transition hover:border-slate-700">
                  <div>
                    <div class="mb-2 inline-flex items-center rounded-md border border-emerald-500/25 bg-emerald-500/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-emerald-300">
                      {sub.metrics}
                    </div>
                    <h4 class="text-base font-bold text-white leading-snug">{sub.title}</h4>
                    <p class="mt-2 text-xs leading-relaxed text-slate-300">
                      {sub.description}
                    </p>
                  </div>
                  <div class="mt-4 border-t border-slate-800/80 pt-3 flex flex-wrap gap-1.5">
                    {sub.tags.map((tag) => (
                      <span class="rounded border border-slate-800 bg-slate-900 px-2 py-0.5 font-mono text-[10px] text-slate-300">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
