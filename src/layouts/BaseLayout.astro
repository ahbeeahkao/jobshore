---
import '../styles/global.css';
import { COMPANY_INFO, SERVICE_PILLARS, buildHomeJsonLd } from '../data/siteData';
import { withBase } from '../utils/paths';
import SeoAeoModal from '../components/SeoAeoModal.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown>;
  keywords?: string[];
}

const {
  title = 'Jobshore | AI Coding, Verification, Testing, OCR, Business Automation, Frappe ERPNext, POS Systems & Web/Mobile Dev',
  description = 'Jobshore is an enterprise AI engineering, business process automation, Frappe ERPNext implementation, Cloud & Offline POS Software & Systems (Malaysia LHDN MyInvois ready), and SEO/AEO-first web & mobile app development consultancy.',
  canonicalPath = '/',
  jsonLd = buildHomeJsonLd(),
  keywords = [
    'AI Coding Services',
    'AI Code Verification',
    'Automated Software Testing',
    'Enterprise AI OCR Malaysia',
    'Intelligent Document Processing',
    'Business Process Automation',
    'Frappe ERPNext Implementation Malaysia',
    'ERPNext Consultation',
    'POS Software Malaysia',
    'Point of Sale System Retail F&B',
    'LHDN MyInvois POS Integration',
    'Web Application Development',
    'Mobile App Development Malaysia',
    'Answer Engine Optimization AEO',
    'Technical SEO Consultancy',
  ],
} = Astro.props;

const normalizedPath = canonicalPath === '/' ? '/' : canonicalPath.replace(/^\//, '/');
const canonicalUrl = `${COMPANY_INFO.domain}${normalizedPath === '/' ? '/' : normalizedPath}`;
const ogImageUrl = `${COMPANY_INFO.domain}/og-image.svg`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={COMPANY_INFO.name} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Canonical & Regional Hreflang Signals for Malaysia / SEA / Global B2B -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-MY" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-SG" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Geographic Metadata (Malaysia / APAC Hub + Global Delivery) -->
    <meta name="geo.region" content="MY-10" />
    <meta name="geo.placename" content="Petaling Jaya, Selangor, Malaysia" />
    <meta name="geo.position" content="3.1073;101.6067" />
    <meta name="ICBM" content="3.1073, 101.6067" />

    <!-- Answer Engine Optimization (AEO) Discovery Links -->
    <link rel="alternate" type="text/markdown" title="LLMs Summary Index (llms.txt)" href={withBase('/llms.txt')} />
    <link rel="alternate" type="text/markdown" title="LLMs Full Reference (llms-full.txt)" href={withBase('/llms-full.txt')} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={withBase('/sitemap.xml')} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={COMPANY_INFO.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:locale:alternate" content="en_SG" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="theme-color" content="#060a12" />

    <!-- Multi-Entity JSON-LD Structured Data Graph for SEO & AEO -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-screen bg-[#060a12] text-slate-100 antialiased selection:bg-sky-500/30 selection:text-white">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-sky-500 focus:px-4 focus:py-2 focus:font-semibold focus:text-slate-950"
    >
      Skip to main content
    </a>

    <!-- Top SEO/AEO Status & Regional Announcement Bar -->
    <div class="border-b border-slate-800/80 bg-slate-950/90 px-4 py-2 text-xs text-slate-300">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-medium text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            ERPNext + POS LHDN MyInvois Ready
          </span>
          <span class="hidden text-slate-500 sm:inline">•</span>
          <span class="text-slate-300">
            Serving <strong class="font-semibold text-white">Malaysia, Singapore, SEA &amp; Global B2B</strong>
          </span>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            data-open-seo-modal
            class="inline-flex items-center gap-1.5 rounded-md border border-sky-500/30 bg-sky-500/10 px-2.5 py-1 text-[11px] font-semibold text-sky-300 transition hover:bg-sky-500/20 cursor-pointer"
          >
            <svg class="h-3.5 w-3.5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>SEO &amp; AEO Score: 100/100 (Inspect Schema &amp; llms.txt)</span>
          </button>
          <a
            href={withBase('/llms.txt')}
            target="_blank"
            rel="noopener"
            class="hidden font-mono text-[11px] text-slate-400 underline decoration-slate-700 underline-offset-4 hover:text-sky-300 md:inline"
          >
            /llms.txt
          </a>
        </div>
      </div>
    </div>

    <!-- Primary Sticky Header -->
    <header class="sticky top-0 z-40 border-b border-slate-800/80 bg-[#060a12]/85 backdrop-blur-xl">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8" aria-label="Main Navigation">
        <!-- Brand Logo -->
        <a href={withBase('/')} class="flex items-center gap-3 group" aria-label="Jobshore Home">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-sky-500/20 via-indigo-500/20 to-emerald-500/20 ring-1 ring-sky-400/40 transition group-hover:ring-sky-400">
            <span class="bg-gradient-to-r from-sky-400 via-indigo-400 to-emerald-400 bg-clip-text text-xl font-black text-transparent">
              J
            </span>
          </div>
          <div>
            <span class="text-xl font-extrabold tracking-tight text-white">Jobshore</span>
            <span class="block text-[10px] font-medium uppercase tracking-widest text-sky-400">
              AI • Automation • ERPNext • POS • Apps
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <div class="hidden items-center gap-0.5 lg:flex">
          <a
            href={withBase('/#ai-services')}
            class="rounded-lg px-2.5 py-2 text-xs xl:text-sm font-medium text-slate-300 transition hover:bg-slate-800/60 hover:text-white"
          >
            AI &amp; OCR
          </a>
          <a
            href={withBase('/#business-automation')}
            class="rounded-lg px-2.5 py-2 text-xs xl:text-sm font-medium text-slate-300 transition hover:bg-slate-800/60 hover:text-white"
          >
            Automation
          </a>
          <a
            href={withBase('/#erpnext-services')}
            class="rounded-lg px-2.5 py-2 text-xs xl:text-sm font-medium text-slate-300 transition hover:bg-slate-800/60 hover:text-white"
          >
            Frappe ERPNext
          </a>
          <a
            href={withBase('/#pos-services')}
            class="rounded-lg px-2.5 py-2 text-xs xl:text-sm font-medium text-amber-300 transition hover:bg-amber-500/10 hover:text-amber-200"
          >
            POS Systems
          </a>
          <a
            href={withBase('/#web-mobile-services')}
            class="rounded-lg px-2.5 py-2 text-xs xl:text-sm font-medium text-slate-300 transition hover:bg-slate-800/60 hover:text-white"
          >
            Web &amp; Mobile
          </a>
          <a
            href={withBase('/#interactive-lab')}
            class="rounded-lg px-2.5 py-2 text-xs xl:text-sm font-medium text-sky-300 transition hover:bg-sky-500/10 hover:text-sky-200"
          >
            Live Demo Lab
          </a>
          <a
            href={withBase('/#why-choose-us')}
            class="rounded-lg px-2.5 py-2 text-xs xl:text-sm font-medium text-emerald-300 transition hover:bg-emerald-500/10 hover:text-emerald-200"
          >
            AI Safety
          </a>
          <a
            href={withBase('/#insights')}
            class="rounded-lg px-2.5 py-2 text-xs xl:text-sm font-medium text-slate-300 transition hover:bg-slate-800/60 hover:text-white"
          >
            Insights
          </a>
          <a
            href={withBase('/#faq')}
            class="rounded-lg px-2.5 py-2 text-xs xl:text-sm font-medium text-slate-300 transition hover:bg-slate-800/60 hover:text-white"
          >
            FAQ
          </a>
        </div>

        <!-- CTA Buttons -->
        <div class="hidden items-center gap-3 sm:flex">
          <a
            href={withBase('/#contact')}
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-sky-500 to-emerald-500 px-4 py-2.5 text-sm font-bold text-slate-950 shadow-lg shadow-sky-500/20 transition hover:brightness-110"
          >
            <span>Book Discovery Call</span>
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>

        <!-- Mobile Menu Toggle -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex items-center justify-center rounded-lg border border-slate-800 bg-slate-900 p-2 text-slate-300 hover:text-white lg:hidden"
          aria-label="Open Navigation Menu"
          aria-expanded="false"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </nav>

      <!-- Mobile Menu Drawer -->
      <div id="mobile-menu" class="hidden border-t border-slate-800 bg-slate-950 px-4 pt-3 pb-6 lg:hidden">
        <div class="flex flex-col space-y-1.5">
          <a href={withBase('/#ai-services')} class="rounded-lg px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-900">
            1. AI Coding, Verification, Testing &amp; OCR
          </a>
          <a href={withBase('/#business-automation')} class="rounded-lg px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-900">
            2. Business Process Automation
          </a>
          <a href={withBase('/#erpnext-services')} class="rounded-lg px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-900">
            3. Frappe &amp; ERPNext Implementation
          </a>
          <a href={withBase('/#pos-services')} class="rounded-lg px-3 py-2 text-sm font-medium text-amber-300 hover:bg-slate-900">
            4. POS Software &amp; Retail/F&amp;B Systems
          </a>
          <a href={withBase('/#web-mobile-services')} class="rounded-lg px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-900">
            5. Web &amp; Mobile App Development
          </a>
          <a href={withBase('/#interactive-lab')} class="rounded-lg px-3 py-2 text-sm font-medium text-sky-400 hover:bg-slate-900">
            Interactive AI OCR, POS &amp; Verification Lab
          </a>
          <a href={withBase('/#roi-calculator')} class="rounded-lg px-3 py-2 text-sm font-medium text-emerald-400 hover:bg-slate-900">
            Automation, POS &amp; ERPNext ROI Calculator
          </a>
          <a href={withBase('/#faq')} class="rounded-lg px-3 py-2 text-sm font-medium text-slate-200 hover:bg-slate-900">
            AEO Knowledge Base &amp; FAQs
          </a>
          <div class="pt-2">
            <a
              href={withBase('/#contact')}
              class="flex w-full items-center justify-center rounded-xl bg-gradient-to-r from-sky-500 to-emerald-500 px-4 py-3 text-sm font-bold text-slate-950"
            >
              Request Architecture &amp; Scope Proposal
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Page Content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Comprehensive Semantic Footer -->
    <footer class="border-t border-slate-800/90 bg-slate-950 text-slate-400" role="contentinfo">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-12">
          <!-- Column 1: Brand & AEO Summary -->
          <div class="lg:col-span-4 space-y-4">
            <a href={withBase('/')} class="flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-sky-500/15 ring-1 ring-sky-400/40">
                <span class="bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-lg font-black text-transparent">
                  J
                </span>
              </div>
              <span class="text-xl font-extrabold text-white">Jobshore</span>
            </a>
            <p class="text-sm leading-relaxed text-slate-400">
              Enterprise AI engineering (coding, deterministic verification, self-healing QA, multi-language OCR),
              end-to-end business process automation, Frappe ERPNext implementation, Cloud &amp; Offline POS Software &amp;
              Systems, and SEO/AEO-first web &amp; mobile application development.
            </p>
            <address class="not-italic text-xs leading-relaxed text-slate-400 space-y-1 pt-1">
              <div class="font-semibold text-slate-200">APAC &amp; Global Delivery Headquarters:</div>
              <div>Petaling Jaya, Selangor, Malaysia (Klang Valley / KL Hub)</div>
              <div>Serving Malaysia, Singapore, Southeast Asia &amp; Global B2B</div>
              <div class="pt-1">
                Email: <a href={`mailto:${COMPANY_INFO.email}`} class="text-sky-400 hover:underline">{COMPANY_INFO.email}</a>
              </div>
            </address>
          </div>

          <!-- Column 2: Core Service Pillars (Internal SEO Links) -->
          <div class="sm:col-span-6 lg:col-span-3 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-white">5 Core Service Pillars</h3>
            <ul class="space-y-2.5 text-sm">
              {SERVICE_PILLARS.map((pillar) => (
                <li>
                  <a
                    href={withBase(`/services/${pillar.slug}`)}
                    class="text-slate-400 transition hover:text-sky-300"
                  >
                    {pillar.shortTitle}
                  </a>
                </li>
              ))}
              <li>
                <a href={withBase('/#erp-comparison')} class="text-slate-400 transition hover:text-sky-300">
                  ERPNext &amp; POS vs. Legacy ERP Matrix
                </a>
              </li>
            </ul>
          </div>

          <!-- Column 3: High-Value Capabilities -->
          <div class="sm:col-span-6 lg:col-span-3 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-white">Specialized Solutions</h3>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a href={withBase('/services/ai-ocr-verification')} class="text-slate-400 hover:text-sky-300">
                  Enterprise Invoice &amp; PO OCR (99.4%)
                </a>
              </li>
              <li>
                <a href={withBase('/services/ai-ocr-verification')} class="text-slate-400 hover:text-sky-300">
                  AI Code Verification &amp; Playwright QA
                </a>
              </li>
              <li>
                <a href={withBase('/services/pos-software-system')} class="text-slate-400 hover:text-amber-300">
                  Cloud &amp; Offline Retail / F&amp;B POS Systems
                </a>
              </li>
              <li>
                <a href={withBase('/services/erpnext-implementation')} class="text-slate-400 hover:text-sky-300">
                  Malaysia LHDN MyInvois (B2B &amp; POS QR)
                </a>
              </li>
              <li>
                <a href={withBase('/services/business-automation')} class="text-slate-400 hover:text-sky-300">
                  3-Way PO-GRN-Invoice Automation
                </a>
              </li>
              <li>
                <a href={withBase('/services/web-mobile-development')} class="text-slate-400 hover:text-sky-300">
                  Offline-First ERPNext &amp; POS Mobile Apps
                </a>
              </li>
            </ul>
          </div>

          <!-- Column 4: SEO & AEO Machine-Readable Index -->
          <div class="lg:col-span-2 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-white">SEO &amp; AEO Index</h3>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a href={withBase('/llms.txt')} target="_blank" rel="noopener" class="font-mono text-xs text-sky-400 hover:underline">
                  /llms.txt (LLM Summary)
                </a>
              </li>
              <li>
                <a href={withBase('/llms-full.txt')} target="_blank" rel="noopener" class="font-mono text-xs text-emerald-400 hover:underline">
                  /llms-full.txt (Full Guide)
                </a>
              </li>
              <li>
                <a href={withBase('/sitemap.xml')} target="_blank" rel="noopener" class="font-mono text-xs text-slate-300 hover:underline">
                  /sitemap.xml
                </a>
              </li>
              <li>
                <a href={withBase('/robots.txt')} target="_blank" rel="noopener" class="font-mono text-xs text-slate-300 hover:underline">
                  /robots.txt
                </a>
              </li>
              <li class="pt-1">
                <button
                  type="button"
                  data-open-seo-modal
                  class="rounded-lg border border-sky-500/30 bg-sky-500/10 px-3 py-1.5 text-xs font-semibold text-sky-300 hover:bg-sky-500/20 cursor-pointer"
                >
                  Inspect JSON-LD Schema
                </button>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-800/80 pt-8 text-xs text-slate-500 sm:flex-row">
          <p>© {new Date().getFullYear()} {COMPANY_INFO.legalName}. All rights reserved. Ready for GitHub Pages &amp; Custom Domain.</p>
          <p class="flex items-center gap-4">
            <span>Frappe ERPNext &amp; POS Open-Source Specialists</span>
            <span>•</span>
            <span>PDPA &amp; ISO/SOC2-Aligned Engineering</span>
          </p>
        </div>
      </div>
    </footer>

    <!-- Live SEO & AEO Inspector Modal -->
    <SeoAeoModal jsonLd={jsonLd} />

    <script>
      const mobileToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');

      mobileToggle?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.contains('hidden');
        if (isHidden) {
          mobileMenu?.classList.remove('hidden');
          mobileToggle.setAttribute('aria-expanded', 'true');
        } else {
          mobileMenu?.classList.add('hidden');
          mobileToggle.setAttribute('aria-expanded', 'false');
        }
      });

      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          mobileToggle?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>
  </body>
</html>
