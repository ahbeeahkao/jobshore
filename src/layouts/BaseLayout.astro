          </div>

          <!-- Column 4: Portfolio & Executive Resources -->
          <div class="lg:col-span-2 space-y-3">
            <h3 class="text-xs font-bold uppercase tracking-wider text-white">Portfolio &amp; Proof</h3>
            <ul class="space-y-2.5 text-sm">
              <li>
                <a href={withBase('/#portfolio')} class="text-emerald-400 hover:underline font-medium">
                  Deployed Portfolio (6)
                </a>
              </li>
              <li>
                <a href={withBase('/#interactive-lab')} class="text-sky-400 hover:underline">
                  Live AI &amp; POS Sandbox
                </a>
              </li>
              <li>
                <a href={withBase('/#roi-calculator')} class="text-slate-400 hover:text-sky-300">
                  ROI &amp; Savings Calculator
                </a>
              </li>
              <li>
                <a href={withBase('/#why-choose-us')} class="text-slate-400 hover:text-sky-300">
                  Zero-Hallucination Safety
                </a>
              </li>
              <li>
                <a href={withBase('/#insights')} class="text-slate-400 hover:text-sky-300">
                  LHDN MyInvois Guides
                </a>
              </li>
              <li>
                <a href={withBase('/#contact')} class="text-slate-400 hover:text-sky-300">
                  14-Day Pilot Scope
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-800/80 pt-8 text-xs text-slate-500 sm:flex-row">
          <p>
            © {new Date().getFullYear()} {COMPANY_INFO.legalName}
            {COMPANY_INFO.ssmRegistrationNo ? ` (${COMPANY_INFO.ssmRegistrationNo})` : ''}. All rights reserved.
          </p>
