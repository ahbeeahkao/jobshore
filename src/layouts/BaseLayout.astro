                </span>
              </div>
              <div>
                <span class="text-xl font-extrabold text-white">{COMPANY_INFO.name}</span>
                {COMPANY_INFO.ssmRegistrationNo && (
                  <span class="block font-mono text-[11px] text-slate-400">
                    {COMPANY_INFO.legalName} ({COMPANY_INFO.ssmRegistrationNo})
