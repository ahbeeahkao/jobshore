---
import '../styles/global.css';
import { COMPANY_INFO, SERVICE_PILLARS, UI_TRANSLATIONS, buildHomeJsonLd } from '../data/siteData';
import { I18N_TEXT_MAP, I18N_PLACEHOLDER_MAP } from '../data/i18nComplete';
import { withBase } from '../utils/paths';
import AiDealConciergeWidget from '../components/AiDealConciergeWidget.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown>;
  keywords?: string[];
}

const {
  title = 'Jobshore | AI Coding, Verification, Testing, OCR, Business Automation, Frappe ERPNext, POS Systems & Web/Mobile Dev',
  description = 'Jobshore is an enterprise AI engineering, business process automation, Frappe ERPNext implementation, Cloud & Offline POS Software & Systems (Malaysia LHDN MyInvois ready), and SEO/AEO-first web & mobile app development consultancy.',
  canonicalPath = '/',
  jsonLd = buildHomeJsonLd(),
  keywords = [
    'AI Coding Services',
    'AI Code Verification',
    'Automated Software Testing',
    'Enterprise AI OCR Malaysia',
    'Intelligent Document Processing',
    'Business Process Automation',
    'Frappe ERPNext Implementation Malaysia',
    'ERPNext Consultation',
    'POS Software Malaysia',
    'Sistem POS e-Invois LHDN',
    '马来西亚 LHDN 电子发票 POS 系统',
    'ERPNext 实施顾问',
    'Point of Sale System Retail F&B',
    'LHDN MyInvois POS Integration',
    'Web Application Development',
    'Mobile App Development Malaysia',
    'Answer Engine Optimization AEO',
    'Technical SEO Consultancy',
  ],
} = Astro.props;

const normalizedPath = canonicalPath === '/' ? '/' : canonicalPath.replace(/^\//, '/');
const canonicalUrl = `${COMPANY_INFO.domain}${normalizedPath === '/' ? '/' : normalizedPath}`;
const ogImageUrl = `${COMPANY_INFO.domain}/og-image.svg`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={COMPANY_INFO.name} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Canonical & Trilingual Regional Hreflang Signals (EN / BM / ZH) -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-MY" href={canonicalUrl} />
    <link rel="alternate" hreflang="ms-MY" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-MY" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-SG" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Geographic Metadata (Malaysia / APAC Hub + Global Delivery) -->
    <meta name="geo.region" content="MY-10" />
    <meta name="geo.placename" content="Petaling Jaya, Selangor, Malaysia" />
    <meta name="geo.position" content="3.1073;101.6067" />
    <meta name="ICBM" content="3.1073, 101.6067" />

    <!-- Answer Engine Optimization (AEO) Discovery Links -->
    <link rel="alternate" type="text/markdown" title="LLMs Summary Index (llms.txt)" href={withBase('/llms.txt')} />
    <link rel="alternate" type="text/markdown" title="LLMs Full Reference (llms-full.txt)" href={withBase('/llms-full.txt')} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={withBase('/sitemap.xml')} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={COMPANY_INFO.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:locale:alternate" content="ms_MY" />
    <meta property="og:locale:alternate" content="zh_MY" />
    <meta property="og:locale:alternate" content="en_SG" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="theme-color" content="#060a12" />

    <!-- Multi-Entity JSON-LD Structured Data Graph for SEO & AEO -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="min-h-screen bg-[#060a12] text-slate-100 antialiased selection:bg-sky-500/30 selection:text-white">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-sky-500 focus:px-4 focus:py-2 focus:font-semibold focus:text-slate-950"
    >
      Skip to main content
    </a>

    <!-- Top SEO/AEO Status, Regional Announcement & Trilingual Switcher Bar -->
    <div class="border-b border-slate-800/80 bg-slate-950/90 px-4 py-2 text-xs text-slate-300">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 font-medium text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            <span id="i18n-top-badge">ERPNext + POS LHDN MyInvois Ready</span>
          </span>
          <span class="hidden text-slate-500 sm:inline">•</span>
          <span class="text-slate-300">
            Serving <strong class="font-semibold text-white">Malaysia, Singapore, SEA &amp; Global B2B</strong>
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-2.5">
          <!-- Language Switcher (EN | BM | 中文) -->
          <div
            class="inline-flex items-center rounded-lg border border-slate-800 bg-slate-900 p-0.5 text-[11px]"
            role="group"
            aria-label="Language Switcher"
          >
            <button
              type="button"
              data-lang-switch="en"
              class="lang-switch-btn rounded-md bg-sky-500 px-2 py-0.5 font-bold text-slate-950 transition cursor-pointer"
            >
              EN
            </button>
            <button
              type="button"
              data-lang-switch="bm"
              class="lang-switch-btn rounded-md px-2 py-0.5 font-semibold text-slate-300 transition hover:text-white cursor-pointer"
            >
              BM
            </button>
            <button
              type="button"
              data-lang-switch="zh"
              class="lang-switch-btn rounded-md px-2 py-0.5 font-semibold text-slate-300 transition hover:text-white cursor-pointer"
