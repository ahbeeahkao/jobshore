---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { COMPANY_INFO } from '../../data/siteData';
import { INSIGHT_ARTICLES, type InsightArticle } from '../../data/insightsData';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return INSIGHT_ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: InsightArticle;
}

const { article } = Astro.props;
const relatedArticles = INSIGHT_ARTICLES.filter((a) => a.slug !== article.slug);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${COMPANY_INFO.domain}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: article.title,
          item: `${COMPANY_INFO.domain}/insights/${article.slug}`,
        },
      ],
    },
    {
      '@type': 'BlogPosting',
      headline: article.title,
      description: article.excerpt,
      datePublished: article.publishedDate,
      dateModified: article.publishedDate,
      author: {
        '@type': 'Organization',
        name: COMPANY_INFO.name,
        url: COMPANY_INFO.domain,
      },
      publisher: {
        '@type': 'Organization',
        name: COMPANY_INFO.name,
        logo: {
          '@type': 'ImageObject',
          url: `${COMPANY_INFO.domain}/favicon.svg`,
        },
      },
      mainEntityOfPage: `${COMPANY_INFO.domain}/insights/${article.slug}`,
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['.aeo-summary'],
      },
    },
  ],
};
---

<BaseLayout
  title={`${article.title} | Jobshore Insights`}
  description={article.aeoDirectAnswer}
  canonicalPath={`/insights/${article.slug}`}
  jsonLd={articleJsonLd}
>
  <article class="py-14 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-slate-400">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={withBase('/')} class="hover:text-sky-400">Home</a></li>
          <li>/</li>
          <li><a href={withBase('/#insights')} class="hover:text-sky-400">Insights &amp; News</a></li>
          <li>/</li>
          <li class="font-semibold text-sky-400" aria-current="page">{article.category}</li>
        </ol>
      </nav>

      <div class="flex flex-wrap items-center gap-3 text-xs">
        <span class="rounded-full border border-sky-500/30 bg-sky-500/10 px-3 py-1 font-bold text-sky-300">
          {article.category}
        </span>
        <time datetime={article.publishedDate} class="font-mono text-slate-400">
          Published: {article.publishedDate}
        </time>
        <span class="text-slate-600">•</span>
        <span class="font-mono text-slate-400">{article.readTime}</span>
      </div>

      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:leading-tight">
        {article.title}
      </h1>

      <!-- AEO Direct Answer Capsule -->
      <aside
        aria-label="Direct Answer Summary"
        class="aeo-summary mt-8 rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-5 text-sm leading-relaxed text-slate-200"
      >
        <div class="mb-1.5 text-xs font-bold uppercase tracking-wider text-emerald-400">
          Direct Answer Summary (AEO Citation Block)
        </div>
        <p>{article.aeoDirectAnswer}</p>
      </aside>

      <!-- Key Takeaways -->
      <div class="mt-8 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
        <h2 class="text-sm font-bold uppercase tracking-wider text-sky-400">Executive Takeaways</h2>
        <ul class="mt-3 space-y-2 text-sm text-slate-300">
          {article.keyTakeaways.map((point) => (
            <li class="flex items-start gap-2.5">
              <span class="font-bold text-emerald-400">✓</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Article Body Sections -->
      <div class="mt-10 space-y-8">
        {article.bodySections.map((sec) => (
          <section class="space-y-3">
            <h2 class="text-xl font-bold text-white sm:text-2xl">{sec.heading}</h2>
            <p class="text-sm sm:text-base leading-relaxed text-slate-300">{sec.content}</p>
          </section>
        ))}
      </div>

      <!-- Related Articles -->
      <div class="mt-14 border-t border-slate-800 pt-10">
        <h3 class="text-lg font-bold text-white">More Jobshore Technical Briefings</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {relatedArticles.map((rel) => (
            <a
              href={withBase(`/insights/${rel.slug}`)}
              class="rounded-xl border border-slate-800 bg-slate-900/50 p-4 transition hover:border-sky-500/40"
            >
              <span class="text-xs font-bold text-sky-400">{rel.category}</span>
              <h4 class="mt-1 text-sm font-bold text-white">{rel.title}</h4>
              <p class="mt-2 text-xs text-slate-400">Read briefing →</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </article>

  <ContactSection />
</BaseLayout>
