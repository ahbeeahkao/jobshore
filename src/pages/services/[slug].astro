---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { COMPANY_INFO, SERVICE_PILLARS, type ServicePillar } from '../../data/siteData';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return SERVICE_PILLARS.map((pillar) => ({
    params: { slug: pillar.slug },
    props: { pillar },
  }));
}

interface Props {
  pillar: ServicePillar;
}

const { pillar } = Astro.props;
const otherPillars = SERVICE_PILLARS.filter((p) => p.slug !== pillar.slug);

const servicePageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${COMPANY_INFO.domain}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pillar.shortTitle,
          item: `${COMPANY_INFO.domain}/services/${pillar.slug}`,
        },
      ],
    },
    {
      '@type': 'Service',
      '@id': `${COMPANY_INFO.domain}/services/${pillar.slug}#service`,
      name: pillar.title,
      serviceType: pillar.shortTitle,
      description: pillar.aeoSummary,
      url: `${COMPANY_INFO.domain}/services/${pillar.slug}`,
      provider: {
        '@type': 'Organization',
        name: COMPANY_INFO.name,
        url: COMPANY_INFO.domain,
      },
      areaServed: ['Malaysia', 'Singapore', 'Southeast Asia', 'Global'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: `${pillar.shortTitle} Outcome Capabilities`,
        itemListElement: pillar.subServices.map((sub, i) => ({
          '@type': 'Offer',
          position: i + 1,
          itemOffered: {
            '@type': 'Service',
            name: sub.title,
            description: sub.description,
          },
        })),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: pillar.faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={`${pillar.shortTitle} | Jobshore Outcome Engineering`}
  description={pillar.aeoSummary}
  canonicalPath={`/services/${pillar.slug}`}
  jsonLd={servicePageJsonLd}
  keywords={[pillar.shortTitle, ...pillar.techStack, 'Jobshore', 'Malaysia', 'Global B2B']}
>
  <!-- Breadcrumb & Hero -->
  <section class="border-b border-slate-800/80 bg-radial-glow bg-grid-pattern py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-6 text-xs text-slate-400">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={withBase('/')} class="hover:text-sky-400">Home</a></li>
          <li>/</li>
          <li><a href={withBase('/#services')} class="hover:text-sky-400">Services</a></li>
          <li>/</li>
          <li class="font-semibold text-sky-400" aria-current="page">{pillar.shortTitle}</li>
        </ol>
      </nav>

      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1 text-xs font-bold text-sky-300">
          {pillar.badge}
        </span>
        <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1 text-xs font-bold text-emerald-300">
          ✓ {pillar.outcomePromise}
        </span>
      </div>

      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-5xl lg:leading-tight">
        {pillar.title}
      </h1>

      <p class="mt-4 max-w-3xl text-base sm:text-lg text-slate-300 leading-relaxed">
        {pillar.subtitle}
      </p>

      <!-- Tangible Monthly Outcome Scorecard Box -->
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-emerald-500/30 bg-emerald-950/20 p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">
              📊 Tangible Monthly Outcome Scorecard
            </span>
            <span class="rounded-md bg-slate-900 px-2.5 py-0.5 font-mono text-[10px] text-sky-300">
              {pillar.commercialModel}
            </span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-slate-200">
            {pillar.tangibleScorecard}
          </p>
        </div>

        <div class="rounded-2xl border border-amber-500/35 bg-amber-950/20 p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-300">
              ⚡ Fast-Start Pilot / Low-Risk Entry Offer
            </span>
            <span class="rounded-md bg-amber-500/20 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-amber-200">
              Close With Zero Risk
            </span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-slate-200">
            {pillar.fastStartCarrot}
          </p>
        </div>
      </div>

      <!-- AEO Direct Answer Capsule -->
      <aside
        aria-label="Direct Answer Summary"
        class="aeo-summary mt-6 rounded-2xl border border-sky-500/30 bg-slate-900/80 p-5 text-sm leading-relaxed text-slate-200"
      >
        <div class="mb-1 text-xs font-bold uppercase tracking-wider text-sky-400">
          Direct Answer Summary (AEO Citation Block)
        </div>
        <p>{pillar.aeoSummary}</p>
      </aside>

      <!-- KPIs -->
      <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {pillar.kpis.map((kpi) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/70 p-4">
            <dd class="text-2xl sm:text-3xl font-extrabold text-sky-400">{kpi.value}</dd>
            <dt class="mt-1 text-xs text-slate-400">{kpi.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Detailed Capabilities Breakdown -->
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 space-y-14">
      <div>
        <h2 class="text-2xl font-extrabold text-white sm:text-3xl">
          Specialized Outcome Modules &amp; Tracked KPIs
        </h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {pillar.subServices.map((sub, i) => (
            <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6 space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-mono text-xs font-bold text-sky-400">OUTCOME MODULE 0{i + 1}</span>
                <span class="rounded-full bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-300">
                  {sub.metrics}
                </span>
              </div>
              <h3 class="text-lg font-bold text-white">{sub.title}</h3>
              <p class="text-sm leading-relaxed text-slate-400">{sub.description}</p>
              <div class="flex flex-wrap gap-1.5 pt-2">
                {sub.tags.map((tag) => (
                  <span class="rounded border border-slate-800 bg-slate-950 px-2.5 py-0.5 font-mono text-[11px] text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Deliverables & Stack Table -->
      <div class="grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-7 rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
          <h3 class="text-lg font-bold text-white">Tangible Production Deliverables &amp; Monthly Proof</h3>
          <ul class="mt-4 space-y-2.5 text-sm text-slate-300">
            {pillar.deliverables.map((d) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 font-bold text-emerald-400">✓</span>
                <span>{d}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-5 rounded-2xl border border-slate-800 bg-slate-900/60 p-6 flex flex-col justify-between space-y-6">
          <div>
            <h3 class="text-lg font-bold text-white">Technology Stack &amp; Commercial Model</h3>
            <p class="mt-2 text-xs font-semibold text-emerald-300">
              {pillar.commercialModel}
            </p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {pillar.techStack.map((t) => (
                <span class="rounded-lg border border-slate-700 bg-slate-950 px-2.5 py-1 font-mono text-xs text-sky-300">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="space-y-2 border-t border-slate-800 pt-4 text-xs">
            <div class="flex justify-between">
              <span class="text-slate-400">Typical Delivery Window:</span>
              <strong class="text-white">{pillar.timeline}</strong>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Engagement Model:</span>
              <strong class="text-emerald-400">
                {COMPANY_INFO.showStartingPrice ? pillar.startingInvestment : COMPANY_INFO.customPriceFallbackText}
              </strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Pillar FAQs -->
      <div>
        <h2 class="text-2xl font-extrabold text-white">Frequently Asked Questions: {pillar.shortTitle}</h2>
        <div class="mt-6 space-y-4">
          {pillar.faqs.map((faq) => (
            <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-5">
              <h3 class="text-base font-bold text-sky-300">{faq.question}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-300">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Cross-Links to Other Jobshore Pillars -->
      <div class="border-t border-slate-800 pt-10">
        <h2 class="text-lg font-bold text-white">Explore Complementary Jobshore Outcome Pillars</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {otherPillars.map((op) => (
            <a
              href={withBase(`/services/${op.slug}`)}
              class="rounded-xl border border-slate-800 bg-slate-900/50 p-4 transition hover:border-sky-500/40"
            >
              <div class="text-xs font-bold text-sky-400">{op.badge}</div>
              <div class="mt-1 text-sm font-bold text-white">{op.shortTitle}</div>
              <div class="mt-2 text-xs text-slate-400">Explore outcome →</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
</BaseLayout>
