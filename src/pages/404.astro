---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICE_PILLARS } from '../data/siteData';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Page Not Found | Jobshore Outcome Engineering"
  description="Explore Jobshore’s 5 Outcome-Guaranteed Engineering Pillars: AI Coding & 99.4% OCR, Business Process Automation, Frappe ERPNext, Cloud & Offline POS Systems, and Web & Mobile Apps."
  canonicalPath="/404"
>
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-2 rounded-full border border-sky-500/30 bg-sky-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-sky-300">
        404 • Route Not Found
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
        This URL Moved—But Your Business Outcomes Haven’t.
      </h1>
      <p class="mt-4 text-base text-slate-400">
        Jump directly to any of our 5 Outcome-Guaranteed Engineering Pillars below, or calculate your 14-day pilot scope &amp; ROI.
      </p>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 text-left">
        {SERVICE_PILLARS.map((pillar) => (
          <a
            href={withBase(`/services/${pillar.slug}`)}
            class="rounded-2xl border border-slate-800 bg-slate-900/70 p-5 transition hover:border-sky-500/50"
          >
            <div class="text-xs font-bold text-sky-400">{pillar.badge.split('•')[0]}</div>
            <div class="mt-1 text-base font-bold text-white">{pillar.shortTitle}</div>
            <p class="mt-1.5 text-xs text-slate-400 line-clamp-2">{pillar.outcomePromise}</p>
            <div class="mt-3 text-xs font-semibold text-emerald-400">Explore Outcome →</div>
          </a>
        ))}

        <a
          href={withBase('/#contact')}
          class="flex flex-col justify-between rounded-2xl border border-emerald-500/40 bg-emerald-950/25 p-5 transition hover:border-emerald-400"
        >
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-emerald-400">Instant AI Scope Closer</div>
            <div class="mt-1 text-base font-bold text-white">Get Your 14-Day Pilot Quote &amp; ROI</div>
            <p class="mt-1.5 text-xs text-slate-300">
              Generate an instant investment range, payback estimate &amp; technical roadmap.
            </p>
          </div>
          <div class="mt-3 text-xs font-bold text-emerald-300">Calculate Quote Now →</div>
        </a>
      </div>

      <div class="mt-10">
        <a
          href={withBase('/')}
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-sky-500 to-emerald-500 px-6 py-3 text-sm font-bold text-slate-950 shadow-lg transition hover:brightness-110"
        >
          <span>← Return to Jobshore Homepage</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
